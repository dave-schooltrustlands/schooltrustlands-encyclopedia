---
interface Line {seq:number;speaker:string;text:string;page:number}
interface Cue {id:string;title:string;tapeSeconds:number;lines:Line[]}
interface Props {cues:Cue[];pageBase:string;audioSrc:string;clipStart:number;duration:number;findingAid:string}
const {cues,pageBase,audioSrc,clipStart,duration,findingAid}=Astro.props;
const clock=(n:number)=>`${Math.floor(n/60)}:${String(Math.floor(n%60)).padStart(2,'0')}`;
// The clip is cut from the tape at clipStart, so a cue's position in the clip
// is its tape position less that offset. Tape times are shown alongside so a
// reader can find the same moment in the archive's own copy.
const marks=cues.map(cue=>({...cue,offset:Math.max(0,Math.round((cue.tapeSeconds-clipStart)*100)/100),tape:clock(cue.tapeSeconds)}));
---
<section class="archive-reading" data-listen aria-labelledby="listen-heading">
  <div class="listening-card">
    <p class="edition-label">First listening edition · Ready for Bob and Dave to try</p>
    <h2 id="listen-heading">Hear the voices, then follow the words</h2>
    <p>Two minutes of the conversation, on this page. Press play and read along, or choose a passage below — each one moves the player to that moment.</p>
    <audio controls preload="metadata" src={audioSrc} aria-label={`Marvin Rowley and Bob Zybach on hardwoods, ${clock(duration)}`}>
      <a href={audioSrc}>Open the audio excerpt</a>
    </audio>
    <p class="clip-note">Two minutes cut from the Library’s preservation copy of tape side 04 (OSU Special Collections and Archives Research Center, Soap Creek Valley oral histories, OH 006). The complete recording is held by the archive; the Library’s copy is not published while rights and notification questions are settled.</p>
    <p class="audio-error" data-error hidden>The audio could not load here. <a href={audioSrc}>Open the excerpt directly</a>, or see <a href="#sources">the original sources</a> below. The transcript remains available.</p>
    <p class="player-status" aria-live="polite" role="status" data-status></p>
    <a class="archive-record" href={findingAid} target="_blank" rel="noopener">The archive’s record of this recording ↗</a>
    <p class="edition-note">The excerpt was cut on September 13, 2026. Its boundaries were measured from the waveform and the words were checked against a machine transcription. Review by ear is still pending.</p>
    <noscript><p class="edition-note">The player and the transcript work without JavaScript. The passage links below jump to the text; use the player’s own controls to move through the audio.</p></noscript>
  </div>
  <nav aria-label="Choose a passage" class="passage-nav">
    {marks.map(cue=><a href={`#${cue.id}`} data-start={cue.offset} data-label={cue.title}><span>{clock(cue.offset)}</span> {cue.title} <em>tape {cue.tape}</em></a>)}
  </nav>
  <p class="reading-note">These are the published words. Spoken wording can differ. The first time on each passage is its place in this two-minute excerpt; the second is its place on the full tape.</p>
  {marks.map(cue=><article id={cue.id} class="passage" aria-labelledby={`${cue.id}-heading`}>
    <p class="source-time"><a class="passage-play" href={`#${cue.id}`} data-start={cue.offset} data-label={cue.title} aria-label={`Play ${cue.title} from ${clock(cue.offset)} in the excerpt`}>▶ {clock(cue.offset)} in the excerpt</a> <span class="tape-time">tape {cue.tape}</span></p>
    <h3 id={`${cue.id}-heading`}>{cue.title}</h3>
    {cue.lines.map(line=><p class="spoken-line"><strong>{line.speaker}:</strong> {line.text} <a class="page-link" href={`${pageBase}#p${line.page}`} aria-label={`Read the original transcript at printed page ${line.page}`}>p. {line.page}</a></p>)}
  </article>)}
</section>
<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-listen]')) {
    const audio = root.querySelector<HTMLAudioElement>('audio');
    if (!audio) continue;
    const status = root.querySelector<HTMLElement>('[data-status]');
    const error = root.querySelector<HTMLElement>('[data-error]');
    let pending: number | null = null;
    const seek = (seconds: number) => {
      const target = Math.max(0, seconds);
      if (audio.readyState >= 1) { audio.currentTime = target; pending = null; }
      else { pending = target; audio.load(); }
      audio.play().catch(() => { if (status) status.textContent = 'Use the player’s own Play control to begin.'; });
    };
    audio.addEventListener('loadedmetadata', () => { if (pending !== null) { audio.currentTime = pending; pending = null; } });
    audio.addEventListener('error', () => { if (error) error.hidden = false; if (status) status.textContent = ''; });
    audio.addEventListener('canplay', () => { if (error) error.hidden = true; });
    window.addEventListener('pagehide', () => audio.pause());
    for (const link of root.querySelectorAll<HTMLAnchorElement>('a[data-start]')) {
      link.addEventListener('click', (event) => {
        const seconds = Number(link.dataset.start);
        if (!Number.isFinite(seconds)) return;
        event.preventDefault();
        seek(seconds);
        const hash = link.getAttribute('href') || '';
        if (hash.startsWith('#')) {
          const passage = document.querySelector<HTMLElement>(hash);
          if (passage) {
            passage.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'start' });
            if (history.replaceState) history.replaceState(null, '', hash);
          }
        }
        if (status) status.textContent = `Playing “${link.dataset.label}”.`;
      });
    }
  }
</script>
<style>
  .archive-reading{margin-top:2rem}.listening-card{background:#edf3ef;border:1px solid #becdc3;border-radius:10px;padding:1.3rem 1.5rem}.listening-card h2{font-size:1.5rem;line-height:1.3;margin:.5rem 0}.listening-card p,.listening-card li{line-height:1.65;max-width:78ch}.edition-label,.source-time{font:700 .9rem/1.5 var(--font-sans,sans-serif);color:#47604e}
  audio{display:block;width:100%;margin:.7rem 0 .8rem}
  .clip-note{font-size:.95rem;color:#425049}
  .archive-record{display:inline-block;background:#244a3b;color:white;padding:.8rem 1.1rem;border-radius:5px;text-decoration:none;font:700 1rem/1.5 var(--font-sans,sans-serif);margin:.4rem 0}.archive-record:hover{background:#17392b}
  .player-status{font:.85rem/1.4 var(--font-sans,sans-serif);margin:.4rem 0 0;min-height:1.2em}
  .edition-note,.reading-note{font-size:.95rem;color:#526159}
  .passage-nav{display:flex;flex-wrap:wrap;gap:.65rem;margin:1rem 0}.passage-nav a{padding:.65rem .85rem;border:1px solid #8ca69b;border-radius:5px;font:1rem/1.5 var(--font-sans,sans-serif);text-decoration:none}.passage-nav span{font-weight:700;margin-right:.35rem;font-variant-numeric:tabular-nums}.passage-nav em{font-style:normal;font-size:.82rem;color:#4d6055;margin-left:.3rem;font-variant-numeric:tabular-nums}.passage-nav a:hover{background:#edf3ef}
  .passage{border-left:4px solid #c2d1c5;background:#fafbf8;padding:1rem 1.3rem;margin:1rem 0;scroll-margin-top:220px}.passage:target{border-color:#496a30;background:#edf3df}
  .source-time{margin:0 0 .4rem;font-variant-numeric:tabular-nums;display:flex;flex-wrap:wrap;align-items:center;gap:.3rem .7rem}
  .passage-play{text-decoration:none;color:#244a3b;border:1px solid #8ca69b;border-radius:5px;background:#fff;padding:.4rem .7rem;min-height:44px;display:inline-flex;align-items:center}.passage-play:hover{background:#dfebe4}
  .tape-time{font-weight:400;color:#4d6055}
  .passage h3{font-size:1.2rem;margin:.4rem 0}.spoken-line{font-size:1.05rem;line-height:1.75;max-width:78ch;margin:.85rem 0}.page-link{white-space:nowrap;font: .9rem var(--font-sans,sans-serif);margin-left:.3rem}a:focus-visible{outline:3px solid #946511;outline-offset:4px}
  [hidden]{display:none!important}
  @media(max-width:40rem){.listening-card{padding:1rem}.passage{padding:1rem}.spoken-line{font-size:1rem}.passage-nav{flex-direction:column}}
</style>
