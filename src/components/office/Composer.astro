---
// The writing box: type or talk, attach, send. Used for a new request and for
// a reply inside a request. All behaviour lives in /office/office.js, which
// finds this by its data-composer attribute. Written for a reader who is not
// technical: big controls, plain words, Send right under the box.
//
// The owner's requests go to Herald. A picker of other helpers is shown only
// when the administrator has switched it on (/office/admin/), and always on
// the administrator's own desk so tests can go to any helper.
import { DEFAULT_HELPER_ID, LIMITS, helperBlurb } from '../../lib/office/config';
import { ALLOWED_EXTENSIONS } from '../../lib/office/files';

interface Props {
  mode: 'new' | 'followup';
  bots?: { id: string; name: string; description: string }[];
  requestId?: string;
  botName?: string;
  /** False when the Workers AI binding is missing; recordings then go to the helper as audio only. */
  canTranscribe: boolean;
  /** Show the choice of helpers (otherwise the request goes to Herald). */
  showPicker?: boolean;
  /** Shown above the box for an administrator sending a test. */
  testNote?: string;
}
const { mode, bots = [], requestId = '', botName = '', canTranscribe, showPicker = false, testNote = '' } = Astro.props;
const accept = ALLOWED_EXTENSIONS.map((e) => '.' + e).join(',');

const main = bots.find((b) => b.id === DEFAULT_HELPER_ID) || bots[0];
const others = bots.filter((b) => b !== main);
const sendTo = mode === 'new' ? (main ? main.name : 'the helper') : botName;

const examples = [
  'Find what the 1850s GLO survey notes say about Soap Creek Valley, and list the sources.',
  'Transcribe the attached interview recording, and mark any words you are unsure of.',
  'Turn my attached notes into a short newsletter article, about 600 words.',
  'Check this draft for mistakes in dates, names, and places.',
];
const mic = '<svg aria-hidden="true" viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="2" width="6" height="12" rx="3"/><path d="M5 10a7 7 0 0 0 14 0"/><path d="M12 17v4"/><path d="M8 21h8"/></svg>';
const clip = '<svg aria-hidden="true" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.4 11.1l-9.2 9.2a6 6 0 0 1-8.5-8.5l9.2-9.2a4 4 0 0 1 5.7 5.7l-9.2 9.2a2 2 0 0 1-2.8-2.8l8.5-8.5"/></svg>';
---
<section
  class="of-card of-composer"
  id={mode === 'new' ? 'of-new' : 'of-reply'}
  data-composer
  data-mode={mode}
  data-request-id={requestId}
  data-max-bytes={LIMITS.fileBytes}
  data-max-files={LIMITS.filesPerMessage}
  data-transcribe={canTranscribe ? '1' : '0'}
  aria-labelledby={`of-composer-h-${mode}`}
>
  <h2 class="of-h2 of-composer-h" id={`of-composer-h-${mode}`}>{mode === 'new' ? 'Ask for something new' : `Write back to ${botName}`}</h2>
  {testNote && <p class="of-note of-note--test">{testNote}</p>}

  {mode === 'new' && main && showPicker && others.length > 0 && (
    <fieldset class="of-bots">
      <legend class="of-big-label">Who should answer?</legend>
      <div class="of-bot-grid">
        {[main, ...others].map((b) => (
          <label class="of-bot">
            <input type="radio" name="of-bot" value={b.id} data-bot-name={b.name} checked={b === main} />
            <span class="of-bot-face">
              <span class="of-bot-name">{b.name}</span>
              {helperBlurb(b) && <span class="of-bot-desc">{helperBlurb(b)}</span>}
            </span>
          </label>
        ))}
      </div>
    </fieldset>
  )}
  {mode === 'new' && main && !(showPicker && others.length > 0) && (
    <input type="hidden" name="of-bot" value={main.id} data-bot-name={main.name} data-default-bot />
  )}

  {mode === 'new' && (
    <>
      <label class="of-big-label" for="of-title">Subject (optional)</label>
      <input class="of-input" id="of-title" type="text" maxlength={LIMITS.titleChars} autocomplete="off" data-title style="margin-bottom: 1.2rem" />
    </>
  )}

  <label class="of-big-label" for={`of-body-${mode}`}>
    {mode === 'new'
      ? `What would you like ${sendTo} to do? Write it the way you would say it.`
      : `Ask for a change or answer ${botName}’s question. For a new topic, go back to the office and start a new request.`}
  </label>
  <textarea
    class="of-textarea"
    id={`of-body-${mode}`}
    rows={mode === 'new' ? 7 : 5}
    maxlength={LIMITS.ownerBodyChars}
    placeholder="Type here, or press “Talk instead of typing”."
    data-body
  ></textarea>

  <div class="of-action-row" data-drop>
    <div class="of-tools">
      <button type="button" class="of-btn of-btn--big of-btn--talk" data-record aria-pressed="false">
        <Fragment set:html={mic} /><span data-record-label>Talk instead of typing</span>
      </button>
      <label class="of-btn of-btn--big">
        <Fragment set:html={clip} /><span>Attach files</span>
        <input type="file" multiple hidden accept={accept} data-file-input />
      </label>
    </div>
    <button type="button" class="of-btn of-btn--primary of-btn--send" data-send data-send-label={`Send to ${sendTo}`}>
      <span>Send to <span data-send-name>{sendTo}</span></span>
    </button>
  </div>
  <p class="of-drop-hint" data-drop-hint hidden>Let go to attach.</p>

  <ul class="of-files" data-files aria-label="Attached files"></ul>
  <p class="of-status" data-status role="status" aria-live="polite"></p>

  {mode === 'new' && (
    <details class="of-examples">
      <summary>Show me some examples</summary>
      <p class="of-examples-h">Tap one to put it in the box, then change it to suit.</p>
      <div class="of-example-list">
        {examples.map((x) => (
          <button type="button" class="of-example" data-example={x}>{x}</button>
        ))}
      </div>
    </details>
  )}
</section>
