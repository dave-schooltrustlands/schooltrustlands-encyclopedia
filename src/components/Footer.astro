---
// 2026-08-09 — one Library, one site. The institutional pages that used
// to live on a separate schooltrusts.org site are now part of this build,
// so these links are local paths.
// 2026-08-13 — restructure: footer trimmed to the identity line, one link
// row, the AI-disclosure line, and the license line. Everything
// methodological now lives behind "For librarians" (/librarians/).
// Oregon-litigation status lives on /court/oregon-current-case/.
import ReferenceDeskFooter from './ReferenceDeskFooter.astro';
import FeedbackLink from './FeedbackLink.astro';
import CorrectionLink from './CorrectionLink.astro';
---
<footer data-pagefind-ignore class="site-footer">
  <ReferenceDeskFooter />
  <FeedbackLink />
  <CorrectionLink />
  <div class="footer-credit">
    <p>
      <strong>America's School Trust Library</strong> &mdash; an Oregon
      nonprofit public benefit corporation (Registry No. 259005891).
    </p>
    <p class="footer-pro-links">
      <span class="footer-group">Read &amp; Research:</span>
      <a href="/catalog/">Catalog</a> ·
      <a href="https://parcelchronicle-refdesk.drdavesullivan.workers.dev" target="_blank" rel="noopener">Research your land's history <span class="footer-beta">Beta</span><span aria-hidden="true"> ↗</span><span class="sr-only"> (opens in a new tab)</span></a>
      <br />
      <span class="footer-group">Get Involved:</span>
      <a href="/contribute/">Ways to help</a>
      <br />
      <span class="footer-group">About:</span>
      <a href="/about/">About</a> ·
      <a href="/independence/">Independence</a> ·
      <a href="/about/corrections/">Corrections</a> ·
      <a href="/about/cite/">How to cite</a> ·
      <a href="/librarians/">How the Library is made</a> ·
      <a href="/permissions/">Rights &amp; permissions</a>
    </p>
  </div>
  <div class="footer-meta">
    <p>
      Built in the open with AI assistance &mdash;
      <a href="/pro/editorial-standards/">editorial standards</a>.
    </p>
    <p>
      Content licensed CC BY-SA 4.0 except where noted.
    </p>
    {/* v9 D.2 — small footer seal mark. Library Mode reveals; Reference
        and Standard hide. The image lands separately Cowork-side; until
        then onerror hides the broken-image glyph. Placed at the very
        bottom of footer-meta so Gamma's reference-desk-footer block
        above is unaffected. */}
    <p class="library-seal-footer-wrap">
      <button
        type="button"
        class="library-seal-button"
        data-seal-trigger
        aria-label="View library seal larger"
      >
        <img
          src="/seal/library-seal-v1.png"
          alt="America's School Trust Library seal"
          class="library-seal library-seal--footer"
          onerror="this.style.display='none'"
        />
      </button>
    </p>
  </div>
</footer>

<style>
  .footer-group {
    font-weight: 600;
  }
  .footer-beta {
    margin-left: 0.2rem;
    padding: 0 0.3rem;
    border: 1px solid var(--old-gold, #b08d57);
    border-radius: 999px;
    font-size: 0.65rem;
    font-weight: 600;
    text-transform: uppercase;
    white-space: nowrap;
  }
</style>
