---
/**
 * WalkingTour — six-panel onboarding overlay for Library Mode.
 *
 * Fires automatically on first home-page visit when body.mode-library is
 * set and localStorage `library-walking-tour-dismissed` is not set. Also
 * fires when any element with [data-open-walking-tour] is clicked
 * (the v7 IllustratedLobby's tour CTA was retired in v9; the trigger
 * remains live for any future surface that wires a [data-open-walking-tour]
 * button).
 *
 * Skip / Done / Esc all set the localStorage key permanently. Focus is
 * trapped inside the dialog while open.
 *
 * Copy register: librarian, not litigator. Newsroom panel mentions
 * "court motions, hearings, settlements" generically — no lawyer names,
 * no case numbers, no specific litigation. Per project memory:
 * library-institutional surfaces don't telegraph litigation.
 */
---

<div
  class="library-walking-tour"
  role="dialog"
  aria-modal="true"
  aria-label="Walking tour of the Library"
  data-open="false"
>
  <div class="lwt-scrim" data-lwt-scrim></div>

  <div class="lwt-card" tabindex="-1">
    <button
      type="button"
      class="lwt-skip"
      data-lwt-skip
      aria-label="Skip the walking tour"
    >
      Skip the tour
    </button>

    <div class="lwt-step is-active" data-step="1">
      <h2>Welcome</h2>
      <p>
        Welcome to America's School Trust Library. Explore the history of land
        set aside to support public schools and the records of how states manage
        it. The Library brings together books, maps, financial reports, legal
        documents, and news so you can see what was promised, what the land
        earned, and what each state makes public. This tour shows you where to
        begin.
      </p>
    </div>

    <div class="lwt-step" data-step="2">
      <p class="lwt-group">School Trusts</p>
      <h2>Compare states and State land maps</h2>
      <p>
        Use Compare states to explore differences in school trust lands, funds,
        and public records. Use State land maps to find available maps and see
        what each state publishes about the location of its trust lands.
      </p>
      <a href="/atlas/" class="lwt-room-link" data-lwt-enter>Compare states →</a>
    </div>

    <div class="lwt-step" data-step="3">
      <p class="lwt-group">School Trusts</p>
      <h2>Trust finances</h2>
      <p>
        Compare school trust funds and payments to schools across states.
        Trust finances shows how well each figure is supported by sources and
        makes gaps in the available financial information clear.
      </p>
      <a href="/counting/" class="lwt-room-link" data-lwt-enter>Trust finances →</a>
    </div>

    <div class="lwt-step" data-step="4">
      <p class="lwt-group">Read &amp; Research</p>
      <h2>Books &amp; documents</h2>
      <p>
        Browse Books &amp; documents for reading organized by topic, including
        history, laws, and research. For information about a particular state,
        choose Find your state under School Trusts in the menu.
      </p>
      <a href="/reading/" class="lwt-room-link" data-lwt-enter>Books &amp; documents →</a>
    </div>

    <div class="lwt-step" data-step="5">
      <p class="lwt-group">Read &amp; Research</p>
      <h2>Writing Room</h2>
      <p>
        The Writing Room is open to readers. Browse a draft handbook on
        school trust law; <em>The Forgotten
        Forever Gift to Public Schools</em>, a history; <em>Who Steals from
        Children</em>, the Oregon record; and <em>Stewards of the Republic</em>,
        ideas for the future. Read essays on building institutions that
        support public schools for generations.
      </p>
      <a href="/writing/" class="lwt-room-link" data-lwt-enter>Writing Room →</a>
    </div>

    <div class="lwt-step" data-step="6">
      <p class="lwt-group">News</p>
      <h2>School trust news and Commentary</h2>
      <p>
        School trust news follows developments in school trust lands and funds,
        including court filings, hearings, and settlements. Commentary shares
        contributors' views on what the records show. A free Library Card lets
        you track your reading and contribute to the Library.
      </p>
      <a href="/newsroom/" class="lwt-room-link" data-lwt-enter>School trust news →</a>
    </div>

    <nav class="lwt-nav" aria-label="Walking tour navigation">
      <button type="button" class="lwt-prev" data-lwt-prev disabled>← Back</button>
      <div class="lwt-progress" data-lwt-progress aria-live="polite">1 of 6</div>
      <button type="button" class="lwt-next" data-lwt-next>Next →</button>
    </nav>
  </div>
</div>

<script is:inline>
  (function () {
    const STORAGE_KEY = 'library-walking-tour-dismissed';
    const root = document.querySelector('.library-walking-tour');
    if (!root) return;

    const card = root.querySelector('.lwt-card');
    const steps = Array.from(root.querySelectorAll('.lwt-step'));
    const prevBtn = root.querySelector('[data-lwt-prev]');
    const nextBtn = root.querySelector('[data-lwt-next]');
    const skipBtn = root.querySelector('[data-lwt-skip]');
    const scrim = root.querySelector('[data-lwt-scrim]');
    const progress = root.querySelector('[data-lwt-progress]');
    const total = steps.length;
    let current = 1;
    let lastFocus = null;

    function setStep(n) {
      current = Math.max(1, Math.min(total, n));
      steps.forEach((el) => {
        const s = Number(el.getAttribute('data-step'));
        el.classList.toggle('is-active', s === current);
      });
      if (prevBtn) prevBtn.disabled = current === 1;
      if (nextBtn) nextBtn.textContent = current === total ? 'Done' : 'Next →';
      if (progress) progress.textContent = current + ' of ' + total;
    }

    function open() {
      lastFocus = document.activeElement;
      root.setAttribute('data-open', 'true');
      setStep(1);
      // Push focus into the dialog so screen readers and keyboard
      // users land on the first interactive control.
      requestAnimationFrame(() => {
        if (card) card.focus();
      });
      document.addEventListener('keydown', onKeydown);
    }

    function close(persist) {
      root.setAttribute('data-open', 'false');
      document.removeEventListener('keydown', onKeydown);
      if (persist) {
        try {
          localStorage.setItem(STORAGE_KEY, '1');
        } catch (_) {
          /* ignore quota / privacy mode */
        }
      }
      if (lastFocus && typeof lastFocus.focus === 'function') {
        try { lastFocus.focus(); } catch (_) {}
      }
    }

    function onKeydown(e) {
      if (e.key === 'Escape') {
        e.preventDefault();
        close(true);
        return;
      }
      if (e.key === 'Tab') {
        // Focus trap inside the card.
        const focusables = root.querySelectorAll(
          'button:not([disabled]), a[href], [tabindex]:not([tabindex="-1"])',
        );
        if (focusables.length === 0) return;
        const first = focusables[0];
        const last = focusables[focusables.length - 1];
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      }
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', function () {
        if (current === total) {
          close(true);
        } else {
          setStep(current + 1);
        }
      });
    }
    if (prevBtn) {
      prevBtn.addEventListener('click', function () {
        setStep(current - 1);
      });
    }
    if (skipBtn) {
      skipBtn.addEventListener('click', function () {
        close(true);
      });
    }
    if (scrim) {
      scrim.addEventListener('click', function () {
        close(true);
      });
    }

    // Triggers from outside: any element with data-open-walking-tour.
    document.addEventListener('click', function (ev) {
      const target = ev.target instanceof Element ? ev.target.closest('[data-open-walking-tour]') : null;
      if (!target) return;
      ev.preventDefault();
      open();
    });

    // 2026-08-13 reader-first restructure: the tour no longer opens itself.
    // A newcomer's first experience should be the subject, not a modal about
    // the Library. The tour remains available from any [data-open-walking-tour]
    // trigger (About page and Librarians' Room).
  })();
</script>

<style>
  /* Section eyebrow matching the five header groups. */
  .lwt-group {
    margin: 0 0 0.25rem;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #7a5c1e;
  }
</style>
