---
// Top-of-page dossier card for state entries. Distinct from the
// right-rail StateDossier component (which lists library cross-links
// alongside the article). This card frames the entry: why the state
// matters, what's actively contested, and where to find the state in
// each library room. Editorial copy (summary, currentIssue) lives in
// state frontmatter; where a state has no summary the card falls back to
// the admission year and the grant, which the Library can state for every
// state.

import courtStates from '../data/court-states.json';

interface Props {
  iso: string; // lowercase, e.g. "us-or"
  name: string;
  admittedDate: Date;
  federalGrantAcres: number | null;
  summary?: string;
  currentIssue?: string;
  // v9 D.1 — visible-drama hook. When the state has no enabling-act
  // citation chain in the substrate, the Atlas-row line renders a
  // locked-drawer SVG (Library Mode only) and a plain text marker in
  // Reference Mode. Default false: card behaves exactly as before.
  enablingActCitationChain?: boolean;
}

const {
  iso,
  name,
  admittedDate,
  federalGrantAcres,
  summary,
  currentIssue,
  enablingActCitationChain = true,
} = Astro.props;

const num = new Intl.NumberFormat('en-US');

function formatAcres(n: number): string {
  if (n >= 1_000_000) return `${(n / 1_000_000).toFixed(1).replace(/\.0$/, '')} million acres`;
  return `${num.format(n)} acres`;
}

const admittedYear = admittedDate.getUTCFullYear();
const grantAcres = federalGrantAcres ?? 0;
const grantClause =
  grantAcres > 0
    ? `It received ${formatAcres(grantAcres)} in federal school-land grants at admission.`
    : 'It is a state-derived state — no federal school-land grant at admission.';

// Only a state with a hand-written `summary` in its frontmatter gets an
// editorial line here. The fallback states the two things the Library can
// assert for every state; it does not splice the paragraph-length
// governance description into the middle of a sentence. Era, governance
// form and grant detail are all carried in the fact table directly above
// this card. Where a state warrants an editorial summary, write one into
// that state's frontmatter.
const fallbackSummary = `${name} entered the Union in ${admittedYear}. ${grantClause}`;
const resolvedSummary = summary && summary.trim().length > 0 ? summary : fallbackSummary;
// No `currentIssue` means the Library has not recorded one. The section is
// omitted rather than stubbed with a dash.
const resolvedIssue = currentIssue && currentIssue.trim().length > 0 ? currentIssue : null;

// The Court Room carries a per-state dossier only for the states listed in
// src/data/court-states.json. For the rest there is no state-scoped court
// address, and this row must not promise one.
const courtCode = iso.replace(/^us-/i, '').toUpperCase();
const courtDossierHref = Object.prototype.hasOwnProperty.call(courtStates, courtCode)
  ? `/court/atlas/${courtCode.toLowerCase()}/`
  : null;
---

<section
  class="rounded-lg border border-slate-200 bg-white p-5 shadow-sm sm:p-6"
  aria-labelledby={`dossier-card-${iso}-heading`}
>
  <p
    id={`dossier-card-${iso}-heading`}
    class="text-xs font-semibold uppercase tracking-wide text-slate-500"
  >
    State dossier
  </p>

  <div class="mt-3">
    <h2 class="text-base font-semibold tracking-tight text-slate-800">Why this state matters</h2>
    <p class="mt-1 text-slate-700">{resolvedSummary}</p>
  </div>

  {resolvedIssue && (
    <div class="mt-4">
      <h2 class="text-base font-semibold tracking-tight text-slate-800">Current issue</h2>
      <p class="mt-1 text-slate-700">{resolvedIssue}</p>
    </div>
  )}

  <div class="mt-4">
    <h2 class="text-base font-semibold tracking-tight text-slate-800">Find this state in</h2>
    <ul class="mt-2 space-y-1 text-sm">
      <li>
        <span class="font-medium text-slate-700">The Atlas:</span>{' '}
        <a href="/atlas/" class="text-blue-700 underline hover:text-blue-900">era cohort lens</a>
        <span class="text-slate-400"> · </span>
        <a href="/atlas/" class="text-blue-700 underline hover:text-blue-900">transparency lens</a>
        {!enablingActCitationChain && (
          <>
            {' '}
            <img
              src="/ornaments/locked-drawer.svg"
              alt=""
              class="state-ornament"
              data-ornament="locked-drawer"
            />
            <span class="state-ornament-fallback text-xs italic text-slate-500">
              {' '}— enabling-act citation chain pending
            </span>
          </>
        )}
      </li>
      <li>
        <span class="font-medium text-slate-700">The Counting House:</span>{' '}
        <a href={`/counting/${iso}/`} class="text-blue-700 underline hover:text-blue-900">financial card</a>
      </li>
      <li>
        <span class="font-medium text-slate-700">The Court Room:</span>{' '}
        {courtDossierHref ? (
          <a href={courtDossierHref} class="text-blue-700 underline hover:text-blue-900">
            this state's case record
          </a>
        ) : (
          <span class="text-slate-500">no dossier for this state yet</span>
        )}
      </li>
      <li>
        <span class="font-medium text-slate-700">Breach &amp; Recovery:</span>{' '}
        <span class="text-slate-500">opening later</span>
      </li>
    </ul>
  </div>
</section>
