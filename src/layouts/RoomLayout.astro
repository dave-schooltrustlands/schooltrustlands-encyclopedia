---
import BaseHead from '../components/BaseHead.astro';
import EAIUtilityBar from '../components/EAIUtilityBar.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PrepublicationFooter from '../components/PrepublicationFooter.astro';
import RoomBanner from '../components/RoomBanner.astro';
import RoomOrnament from '../components/library/RoomOrnament.astro';
import SealLightbox from '../components/library/SealLightbox.astro';
import Breadcrumb from '../components/Breadcrumb.astro';

type RoomId =
  | 'reading'
  | 'atlas'
  | 'maps'
  | 'counting'
  | 'newsroom'
  | 'reference-desk'
  | 'writing'
  | 'records'
  | 'court'
  | 'breach-recovery'
  | 'founders'
  | 'lectures'
  | 'collections';

// Rooms that have a signature banner image in /public/banners/.
// v10 sub-release v1.B — banner-above-h1 slot lives in RoomLayout so
// every sub-page inherits the banner without re-mounting it per page.
// v57b — Reference Desk graduates to a banner room; banner image
// already installed in v56 at /banners/reference-desk.jpg.
// v57b cleanup — Newsroom joins the banner-room set; the page itself
// uses its own publishing layout so the lower-nav tab strip won't
// appear ON /newsroom/, but Newsroom appears in the tab strip on every
// other library page.
// v3.0 — Court Room promoted from Coming Soon to live and joins the
// banner-room set; banner image already installed in v56 at
// /banners/court.jpg.
// Zybach Collection (Phase 3) — Collections joins the RoomId union and the
// banner set; banner image installed at /banners/collections.jpg.
type BannerRoomId = 'reading' | 'atlas' | 'maps' | 'counting' | 'newsroom' | 'reference-desk' | 'writing' | 'court' | 'collections';
const BANNER_ROOMS: ReadonlyArray<BannerRoomId> = [
  'reading',
  'atlas',
  'maps',
  'counting',
  'newsroom',
  'reference-desk',
  'writing',
  'court',
  'collections',
];
const isBannerRoom = (id: RoomId): id is BannerRoomId =>
  (BANNER_ROOMS as ReadonlyArray<RoomId>).includes(id);

interface Props {
  room: RoomId;
  state?: { iso: string; name: string }; // for state-scoped pages
  title: string;
  subtitle?: string;
  width?: 'prose' | 'full';
  pageTitle?: string; // <title>; defaults to `${title} · America's School Trust Library`
  // v61 — Optional intermediate breadcrumb segments between the room
  // and the current page. Used by nested book pages where the
  // hierarchy is Lobby ▸ Writing Room ▸ Eighth Anchor ▸ III. The
  // current page is always derived from `title`; this prop carries
  // only the in-between segments. Empty / omitted produces a
  // 2- or 3-segment breadcrumb depending on whether title matches
  // the room label.
  parents?: ReadonlyArray<{ label: string; href: string }>;
  // Plan_v2.1 Q8 seam: future feedback form constructs context from
  // these. Render now even though no consumer exists yet — retrofitting
  // metadata across six rooms in twelve months is more work than
  // threading it through templates today.
  sourceId: string;
  // Optional Pagefind facet overrides (era for essays, etc.). Room
  // and state are emitted automatically as facets when present.
  pagefindEra?: string;
  // Zybach Collection (Phase 3) — pages that are published but not yet
  // ready to be indexed by search engines (a preview under review by the
  // creator) pass `noindex` and get <meta name="robots" content="noindex">.
  // Pagefind still indexes them, so site search keeps working.
  noindex?: boolean;
  /** Exclude the entire page, including its URL and metadata, from site search. */
  pagefindIgnore?: boolean;
}

const {
  room,
  state,
  title,
  subtitle,
  width = 'prose',
  pageTitle,
  parents,
  sourceId,
  pagefindEra,
  noindex = false,
  pagefindIgnore = false,
} = Astro.props;

// v61 — Lower-nav room-tab strip retired. Sideways navigation moves to
// the header's Rooms ▾ disclosure; vertical wayfinding lives in the
// new Breadcrumb component rendered below the banner. The ROOMS array
// (icons + tab labels) is gone with it; what remains here are the
// label/href lookups the breadcrumb needs to assemble its segments,
// and the title-chain map used to generate <title>.
const roomNameMap: Record<RoomId, string> = {
  reading: 'Reading Room',
  atlas: 'Atlas',
  maps: 'Map Room',
  counting: 'Counting House',
  newsroom: 'Newsroom',
  'reference-desk': 'Reference Desk',
  writing: 'Writing Room',
  records: 'Records Room',
  court: 'Court Room',
  'breach-recovery': 'Breach & Recovery',
  founders: "Founders' Cabinet",
  lectures: 'Lecture Hall',
  collections: 'Collections',
};
const roomHrefMap: Record<RoomId, string> = {
  reading: '/reading/',
  atlas: '/atlas/',
  maps: '/maps/',
  counting: '/counting/',
  newsroom: '/newsroom/',
  'reference-desk': '/reference-desk/',
  writing: '/writing/',
  records: '/records/',
  court: '/court/',
  'breach-recovery': '/breach-recovery/',
  founders: '/founders/',
  lectures: '/lectures/',
  collections: '/collections/',
};

// Build the breadcrumb segments. Lobby is always the first segment.
// If `title` matches the room label and `parents` is empty, we're on
// the room index — collapse to 2 segments (Lobby ▸ <Room>). Otherwise
// the room sits between Lobby and `parents` + the current `title`.
// The `state` prop is retained for <title>-chain and Pagefind facets
// but is no longer the breadcrumb's current-page label; pages always
// use `title` as the current segment so nav reads naturally on both
// the state-dossier page itself (where title === state.name) and on
// state-dossier sub-pages (where the page passes its own title and an
// explicit `parents` entry for the dossier).
const roomLabel = roomNameMap[room];
const isRoomIndex =
  (!parents || parents.length === 0) &&
  title === roomLabel;
const breadcrumbSegments = isRoomIndex
  ? [
      { label: 'Lobby', href: '/explore/' },
      { label: roomLabel },
    ]
  : [
      { label: 'Lobby', href: '/explore/' },
      { label: roomLabel, href: roomHrefMap[room] },
      ...(parents ?? []),
      { label: title },
    ];

// Title chain uses middle dot (·) so multi-segment titles like
// "Oregon · Counting House · America's School Trust Library" stay readable.
// Em-dashes were dropped after Day_10 #5.
const resolvedTitle =
  pageTitle ??
  (state
    ? `${state.name} · ${roomNameMap[room]} · America's School Trust Library`
    : `${title} · America's School Trust Library`);

// Collection search facets come from the public route, never from raw held data.
const zybachSeries = /^\/collections\/zybach\/(soap-creek|elliott|letitia-carson|jedediah-smith)(?:\/|$)/.exec(Astro.url.pathname)?.[1];
const isZybach = Astro.url.pathname.startsWith('/collections/zybach/');
const mainClass =
  width === 'full'
    ? 'mx-auto max-w-5xl p-4 sm:p-8'
    : 'mx-auto max-w-prose p-4 sm:p-8';
---

<!doctype html>
<html lang="en" data-pagefind-ignore={pagefindIgnore ? 'all' : undefined}>
  <head>
    <BaseHead title={resolvedTitle} />
    {noindex && <meta name="robots" content="noindex" />}
  </head>
  <body
    class="min-h-screen bg-archive-paper text-ink mode-library"
    data-source-id={sourceId}
    data-room={room}
    data-state={state?.iso}
  >
    <span data-pagefind-meta={`room:${room}`} hidden></span>
    {state && <span data-pagefind-meta={`state:${state.iso}`} hidden></span>}
    {state && <span data-pagefind-filter={`state:${state.iso}`} hidden></span>}
    <span data-pagefind-filter={`room:${room}`} hidden></span>
    {pagefindEra && <span data-pagefind-meta={`era:${pagefindEra}`} hidden></span>}
    {pagefindEra && <span data-pagefind-filter={`era:${pagefindEra}`} hidden></span>}
    {zybachSeries && !pagefindIgnore && <span data-pagefind-filter={`zybach_series:${zybachSeries}`} hidden></span>}
    <div style="display:contents" data-pagefind-ignore={room === 'collections' ? 'all' : undefined}>
    {isZybach ? (
      <header class="zybach-library-masthead">
        <a href="/explore/">America’s School Trust Library</a>
        <a href="/collections/zybach/">The Zybach Collection</a>
      </header>
    ) : <><EAIUtilityBar /><Header /></>}

    <Breadcrumb segments={isZybach ? breadcrumbSegments.filter(s => s.label !== "Collections").map(s => s.label === "Lobby" ? {...s,label:"Library home"} : s) : breadcrumbSegments} />
    </div>

    <main class={`${mainClass} room-main`}>
      <slot name="above-header">
        {isBannerRoom(room) && room !== 'collections' && <RoomBanner room={room} />}
      </slot>
      {room === 'reading' && <RoomOrnament shape="book" />}
      {room === 'atlas' && <RoomOrnament shape="map" />}
      {room === 'maps' && <RoomOrnament shape="compass" />}
      {room === 'counting' && <RoomOrnament shape="scales" />}
      <header class="border-b border-slate-200 pb-6">
        <slot name="before-title" />
        <h1 data-pagefind-weight="10" class="text-3xl font-bold tracking-tight sm:text-4xl">
          {title}
        </h1>
        {subtitle && (
          <p class="mt-3 text-slate-700">{subtitle}</p>
        )}
        <slot name="header-extras" />
      </header>

      <slot />
    </main>

    <div style="display:contents" data-pagefind-ignore={room === 'collections' ? 'all' : undefined}>
    <PrepublicationFooter />
    <Footer />
    <SealLightbox />
    </div>
  </body>
</html>

<style>
  .zybach-library-masthead {max-width:64rem;margin:auto;padding:1rem 2rem;display:flex;justify-content:space-between;gap:1rem;flex-wrap:wrap;border-bottom:1px solid #d8d1c2;font: .95rem/1.5 var(--font-sans)}
  .zybach-library-masthead a {color:#14243c;text-decoration:underline;text-underline-offset:3px}
</style>
