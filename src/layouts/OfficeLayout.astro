---
// Layout for the private research office (/office/...).
// Self-contained on purpose, like ForeverPromiseLayout: no public Header or
// Footer, so nothing from the public site (search, feedback forms, sign-in
// widgets, analytics) loads inside the office and no public page links in.
// It loads the Library's two typefaces itself and carries the shared palette.
// There is no inline script here or on any office page: the one script file
// is /office/office.js, which lets the gate send a strict content policy.
import type { OfficeUser } from '../lib/office/config';

interface Props {
  title: string;
  officeName: string;
  user: OfficeUser;
  page: 'desk' | 'thread' | 'admin';
  adminCanRead: boolean;
}
const { title, officeName, user, page, adminCanRead } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow, noarchive" />
  <meta name="referrer" content="no-referrer" />
  <title>{title} · {officeName}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400..700;1,6..72,400..700&family=Public+Sans:ital,wght@0,400..700;1,400..700&display=swap" rel="stylesheet" />
</head>
<body class="of-body" data-page={page}>
  <a class="of-skip" href="#of-main">Skip to the office</a>
  <header class="of-bar">
    <a class="of-brand" href="/office/">
      <span class="of-brand-lib">America&rsquo;s School Trust Library</span>
      <span class="of-brand-name">{officeName}</span>
    </a>
    <nav class="of-nav" aria-label="Office">
      <a href="/office/" aria-current={page === 'desk' ? 'page' : undefined}>Desk</a>
      {user.isAdmin && <a href="/office/admin/" aria-current={page === 'admin' ? 'page' : undefined}>Admin</a>}
      <a href="/cdn-cgi/access/logout">Sign out</a>
    </nav>
  </header>

  <main class="of-main" id="of-main">
    <slot />
  </main>

  <footer class="of-foot">
    <p>
      <span class="of-lock" aria-hidden="true"></span>
      Private office. Signed in as {user.email}.
      {adminCanRead
        ? 'The Library’s administrator can also read what is here.'
        : 'Only the owner of this office can read what is here.'}
    </p>
    <p>Nothing here is public. A reply reaches the Library only if it is suggested and then approved.</p>
  </footer>

  <script is:inline src="/office/office.js?v=2" defer></script>
</body>
</html>

<style is:global>
  :root {
    --of-ink: #1a1a2e; --of-blue: #1b3252; --of-navy: #14243c;
    --of-paper: #f5f1e8; --of-linen: #fffdf7; --of-rule: #d8d1c2;
    --of-gold: #a87f2c; --of-gold-text: #7a5a17; --of-sage: #6f7f52; --of-oxblood: #7a2e2e;
    --of-verified: #2f6f4e; --of-pending: #5e5a8a; --of-muted: #5f5a4d;
    --of-serif: 'Newsreader', 'Iowan Old Style', Georgia, serif;
    --of-sans: 'Public Sans', system-ui, -apple-system, 'Segoe UI', sans-serif;
  }
  html { background: var(--of-paper); }
  body.of-body { margin: 0; min-height: 100vh; display: flex; flex-direction: column; background: var(--of-paper);
    color: var(--of-ink); font-family: var(--of-serif); font-size: 1.0625rem; line-height: 1.6; -webkit-text-size-adjust: 100%; }
  .of-body *, .of-body *::before, .of-body *::after { box-sizing: border-box; }
  .of-body [hidden] { display: none !important; }
  .of-body a { color: var(--of-blue); text-underline-offset: 2px; }
  .of-body :focus-visible { outline: 2px solid var(--of-gold); outline-offset: 2px; }
  .of-skip { position: absolute; left: 1rem; top: -4rem; z-index: 50; background: var(--of-linen); color: var(--of-navy);
    font: 700 .85rem/1 var(--of-sans); padding: .7rem 1rem; border: 2px solid var(--of-gold); }
  .of-skip:focus { top: .75rem; }

  /* Top bar */
  .of-bar { background: var(--of-navy); color: var(--of-paper); display: flex; flex-wrap: wrap; align-items: center;
    justify-content: space-between; gap: .4rem 1.5rem; padding: .7rem 1.4rem; border-bottom: 3px solid var(--of-gold); }
  .of-bar a { color: inherit; }
  .of-brand { text-decoration: none; display: flex; flex-direction: column; gap: .1rem; }
  .of-brand-lib { font: 700 .62rem/1.2 var(--of-sans); letter-spacing: .16em; text-transform: uppercase; color: #d9bd7a; }
  .of-brand-name { font: 600 1.35rem/1.15 var(--of-serif); letter-spacing: -.01em; color: #fffaf0; }
  .of-nav { display: flex; align-items: center; gap: 1.25rem; font: 600 .82rem/1 var(--of-sans); }
  .of-nav a { text-decoration: none; padding: .5rem 0; border-bottom: 2px solid transparent; color: #e8e2d4; }
  .of-nav a:hover, .of-nav a[aria-current='page'] { color: #fff; border-bottom-color: #d9bd7a; }

  .of-main { width: 100%; max-width: 50rem; margin: 0 auto; padding: 2.2rem 1.25rem 3.5rem; flex: 1; }
  body[data-page='admin'] .of-main { max-width: 62rem; }

  /* Type */
  .of-eyebrow { display: block; margin: 0 0 .4rem; font: 700 .68rem/1.2 var(--of-sans); letter-spacing: .17em;
    text-transform: uppercase; color: var(--of-gold-text); }
  .of-h1 { margin: 0 0 .35rem; font: 800 clamp(1.8rem, 4vw, 2.35rem)/1.12 var(--of-serif); letter-spacing: -.02em; color: var(--of-navy); overflow-wrap: anywhere; }
  .of-h2 { margin: 0 0 .9rem; font: 700 1.3rem/1.2 var(--of-serif); letter-spacing: -.01em; color: var(--of-navy); }
  .of-lede { margin: 0 0 1.6rem; color: #3b3a47; max-width: 40rem; }
  .of-meta { font: 400 .8rem/1.4 var(--of-sans); color: var(--of-muted); }
  .of-back { display: inline-block; margin-bottom: 1.1rem; font: 600 .8rem/1 var(--of-sans); text-decoration: none; }
  .of-back:hover { text-decoration: underline; }

  /* Cards */
  .of-card { background: var(--of-linen); border: 1px solid var(--of-rule); border-top: 3px solid var(--of-gold);
    padding: 1.4rem 1.5rem 1.5rem; margin: 0 0 2.2rem; box-shadow: 0 8px 24px rgba(20, 36, 60, .05); }
  .of-card--plain { border-top-width: 1px; box-shadow: none; }
  .of-note { background: #f0ebdd; border-left: 3px solid var(--of-gold); padding: .7rem 1rem; margin: 0 0 1.4rem;
    font: 400 .9rem/1.5 var(--of-sans); color: #3b3a47; }
  .of-note--warn { border-left-color: var(--of-oxblood); background: #f6e9e6; }

  /* Forms */
  .of-label { display: block; margin: 1.1rem 0 .35rem; font: 700 .72rem/1.2 var(--of-sans); letter-spacing: .08em;
    text-transform: uppercase; color: var(--of-navy); }
  .of-label small { font-weight: 400; letter-spacing: 0; text-transform: none; color: var(--of-muted); }
  .of-input, .of-textarea, .of-select { display: block; width: 100%; margin: 0; padding: .6rem .7rem; background: #fff;
    border: 1px solid #b9b09c; border-radius: 3px; color: var(--of-ink); font: 400 1rem/1.5 var(--of-sans); }
  .of-textarea { min-height: 9rem; resize: vertical; font-family: var(--of-serif); font-size: 1.08rem; line-height: 1.55; }
  .of-input:focus, .of-textarea:focus, .of-select:focus { outline: 2px solid var(--of-blue); outline-offset: 0; border-color: var(--of-blue); }
  .of-btn { display: inline-flex; align-items: center; justify-content: center; gap: .45rem; min-height: 2.6rem; padding: .55rem 1.05rem;
    border: 1px solid var(--of-blue); border-radius: 3px; background: var(--of-linen); color: var(--of-blue); cursor: pointer;
    font: 700 .84rem/1.1 var(--of-sans); letter-spacing: .02em; text-decoration: none; }
  .of-btn:hover { background: #eef1f6; }
  .of-btn--primary { background: var(--of-blue); color: var(--of-linen); }
  .of-btn--primary:hover { background: var(--of-navy); }
  .of-btn--danger { border-color: var(--of-oxblood); color: var(--of-oxblood); }
  .of-btn--danger:hover { background: #f6e9e6; }
  .of-btn--quiet { border-color: transparent; background: none; padding-left: .3rem; padding-right: .3rem; min-height: 2rem; font-weight: 600; }
  .of-btn--quiet:hover { background: none; text-decoration: underline; }
  .of-btn[disabled] { opacity: .55; cursor: default; }
  .of-btn--recording { background: var(--of-oxblood); border-color: var(--of-oxblood); color: #fff; }
  .of-btn--recording:hover { background: #662525; }
  .of-row { display: flex; flex-wrap: wrap; align-items: center; gap: .6rem; }
  .of-status { min-height: 1.3rem; margin: .8rem 0 0; font: 400 .88rem/1.45 var(--of-sans); color: var(--of-muted); }
  .of-status[data-tone='error'] { color: var(--of-oxblood); font-weight: 600; }
  .of-status[data-tone='good'] { color: var(--of-verified); font-weight: 600; }

  /* Bot picker */
  .of-bots { border: 0; margin: 0; padding: 0; min-width: 0; }
  .of-bots legend { padding: 0; margin-top: 0; }
  .of-bot-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr)); gap: .6rem; }
  .of-bot { position: relative; display: block; cursor: pointer; }
  .of-bot input { position: absolute; opacity: 0; inset: 0; margin: 0; cursor: pointer; }
  .of-bot-face { display: block; height: 100%; padding: .7rem .85rem; background: #fff; border: 1px solid #b9b09c; border-radius: 3px; }
  .of-bot-name { display: block; font: 700 .98rem/1.25 var(--of-sans); color: var(--of-navy); }
  .of-bot-desc { display: block; margin-top: .2rem; font: 400 .8rem/1.4 var(--of-sans); color: var(--of-muted); }
  .of-bot input:checked + .of-bot-face { border-color: var(--of-blue); box-shadow: inset 0 0 0 2px var(--of-blue); background: #f3f6fa; }
  .of-bot input:focus-visible + .of-bot-face { outline: 2px solid var(--of-gold); outline-offset: 2px; }

  /* Composer */
  .of-tools { margin-top: .9rem; }
  .of-rec-time { font: 600 .85rem/1 var(--of-sans); font-variant-numeric: tabular-nums; color: var(--of-oxblood); }
  .of-files { list-style: none; margin: .9rem 0 0; padding: 0; display: grid; gap: .45rem; }
  .of-files:empty { display: none; }
  .of-file { display: flex; flex-wrap: wrap; align-items: center; gap: .5rem .8rem; padding: .5rem .7rem; background: #fff;
    border: 1px solid var(--of-rule); border-radius: 3px; font: 400 .88rem/1.35 var(--of-sans); }
  .of-file-name { font-weight: 600; color: var(--of-navy); overflow-wrap: anywhere; }
  .of-file-size { color: var(--of-muted); }
  .of-file audio { width: 100%; height: 2.25rem; }
  .of-send-row { margin-top: 1.2rem; justify-content: space-between; }

  /* Thread list */
  .of-threads { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--of-rule); }
  .of-thread { border-bottom: 1px solid var(--of-rule); }
  .of-thread a { display: grid; grid-template-columns: .7rem 1fr auto; gap: .2rem .8rem; align-items: baseline; padding: .95rem .5rem;
    text-decoration: none; color: inherit; }
  .of-thread a:hover { background: var(--of-linen); }
  .of-dot { width: .55rem; height: .55rem; border-radius: 50%; align-self: center; }
  .of-thread[data-unread='1'] .of-dot { background: var(--of-gold); }
  .of-thread-title { font: 600 1.12rem/1.3 var(--of-serif); color: var(--of-navy); overflow-wrap: anywhere; }
  .of-thread[data-unread='1'] .of-thread-title { font-weight: 800; }
  .of-thread-sub { grid-column: 2 / -1; font: 400 .8rem/1.4 var(--of-sans); color: var(--of-muted); }
  .of-empty { padding: 1.6rem .5rem; color: var(--of-muted); font-style: italic; }

  /* Status chips */
  .of-chip { display: inline-block; padding: .22rem .5rem; border-radius: 2px; background: var(--of-pending); color: #fff;
    font: 700 .64rem/1.2 var(--of-sans); letter-spacing: .07em; text-transform: uppercase; white-space: nowrap; }
  .of-chip[data-status='claimed'], .of-chip[data-status='in_progress'] { background: var(--of-blue); }
  .of-chip[data-status='answered'], .of-chip[data-status='approved'] { background: var(--of-verified); }
  .of-chip[data-status='needs_info'], .of-chip[data-status='nominated'] { background: #8a5a12; }
  .of-chip[data-status='failed'], .of-chip[data-status='rejected'], .of-chip[data-status='revoked'] { background: var(--of-oxblood); }
  .of-chip[data-status='withdrawn'], .of-chip[data-status='off'] { background: #6b6455; }

  /* Thread */
  .of-thread-head { margin-bottom: 1.6rem; padding-bottom: 1.2rem; border-bottom: 1px solid var(--of-rule); }
  .of-thread-head .of-row { margin-top: .6rem; }
  .of-msg { margin: 0 0 1.4rem; padding: 1.1rem 1.3rem 1.2rem; background: var(--of-linen); border: 1px solid var(--of-rule); }
  .of-msg--owner { border-left: 3px solid var(--of-blue); }
  .of-msg--bot { border-top: 3px solid var(--of-gold); box-shadow: 0 8px 24px rgba(20, 36, 60, .05); }
  .of-msg-head { display: flex; flex-wrap: wrap; align-items: baseline; gap: .3rem .8rem; margin-bottom: .6rem; }
  .of-msg-who { font: 700 .74rem/1.2 var(--of-sans); letter-spacing: .12em; text-transform: uppercase; color: var(--of-navy); }
  .of-msg--bot .of-msg-who { color: var(--of-gold-text); }
  .of-msg-foot { margin-top: 1rem; padding-top: .8rem; border-top: 1px dashed var(--of-rule); font: 400 .85rem/1.5 var(--of-sans); color: var(--of-muted); }
  .of-msg-foot summary { cursor: pointer; font-weight: 600; color: var(--of-blue); }
  .of-thumb { display: block; max-width: 100%; max-height: 16rem; border: 1px solid var(--of-rule); }
  .of-transcript { width: 100%; font: 400 .88rem/1.5 var(--of-sans); color: #3b3a47; }
  .of-transcript summary { cursor: pointer; color: var(--of-blue); font-weight: 600; }
  .of-transcript p { margin: .4rem 0 0; white-space: pre-wrap; }

  /* Rendered markdown */
  .of-prose { overflow-wrap: anywhere; }
  .of-prose > :first-child { margin-top: 0; }
  .of-prose > :last-child { margin-bottom: 0; }
  .of-prose p, .of-prose ul, .of-prose ol, .of-prose blockquote, .of-prose pre, .of-prose table { margin: 0 0 .9em; }
  .of-prose h1, .of-prose h2, .of-prose h3, .of-prose h4 { margin: 1.3em 0 .5em; font-family: var(--of-serif); font-weight: 700;
    line-height: 1.25; letter-spacing: -.01em; color: var(--of-navy); }
  .of-prose h1 { font-size: 1.45rem; } .of-prose h2 { font-size: 1.28rem; } .of-prose h3 { font-size: 1.12rem; } .of-prose h4 { font-size: 1rem; }
  .of-prose ul { list-style: disc; padding-left: 1.4rem; } .of-prose ol { list-style: decimal; padding-left: 1.5rem; }
  .of-prose li { margin: .2em 0; }
  .of-prose blockquote { padding: .1rem 0 .1rem 1rem; border-left: 2px solid var(--of-gold); color: #3b3a47; font-style: italic; }
  .of-prose code { font: .86em/1.5 ui-monospace, 'SF Mono', Menlo, Consolas, monospace; background: #f0ebdd; padding: .08em .3em; border-radius: 2px; }
  .of-prose pre { overflow-x: auto; padding: .8rem 1rem; background: #f0ebdd; border: 1px solid var(--of-rule); }
  .of-prose pre code { background: none; padding: 0; }
  .of-prose table { display: block; overflow-x: auto; border-collapse: collapse; font: 400 .88rem/1.45 var(--of-sans); font-variant-numeric: tabular-nums; }
  .of-prose th, .of-prose td { border: 1px solid var(--of-rule); padding: .4rem .6rem; text-align: left; vertical-align: top; }
  .of-prose th { background: #f0ebdd; font-weight: 700; color: var(--of-navy); }
  .of-prose hr { border: 0; border-top: 1px solid var(--of-rule); margin: 1.4em 0; }

  /* Admin tables */
  .of-table-wrap { overflow-x: auto; margin: 0 0 1rem; }
  .of-table { width: 100%; border-collapse: collapse; font: 400 .86rem/1.4 var(--of-sans); font-variant-numeric: tabular-nums; }
  .of-table th { text-align: left; padding: .45rem .6rem; border-bottom: 2px solid var(--of-rule); white-space: nowrap;
    font: 700 .66rem/1.2 var(--of-sans); letter-spacing: .09em; text-transform: uppercase; color: var(--of-muted); }
  .of-table td { padding: .5rem .6rem; border-bottom: 1px solid var(--of-rule); vertical-align: top; }
  .of-nowrap { white-space: nowrap; }
  .of-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr)); gap: 0 1rem; }
  .of-check { display: flex; align-items: center; gap: .5rem; margin-top: 1rem; font: 400 .9rem/1.3 var(--of-sans); }
  .of-secret { display: block; margin: .6rem 0; padding: .7rem .8rem; background: #fff; border: 1px dashed var(--of-gold);
    font: .85rem/1.5 ui-monospace, 'SF Mono', Menlo, Consolas, monospace; overflow-wrap: anywhere; user-select: all; }
  .of-pub { padding: 1rem 0 1.2rem; border-top: 1px solid var(--of-rule); }
  .of-pub:first-of-type { border-top: 0; padding-top: 0; }

  .of-foot { padding: 1.3rem 1.25rem 2rem; border-top: 1px solid var(--of-rule); text-align: center; font: 400 .78rem/1.55 var(--of-sans); color: var(--of-muted); }
  .of-foot p { margin: .15rem 0; }
  .of-lock { display: inline-block; width: .5rem; height: .5rem; margin-right: .35rem; border-radius: 50%; background: var(--of-verified); }

  @media (max-width: 560px) {
    .of-bar { padding: .65rem 1rem; }
    .of-main { padding: 1.5rem 1rem 3rem; }
    .of-card { padding: 1.1rem 1rem 1.2rem; }
    .of-msg { padding: 1rem; }
    .of-thread a { grid-template-columns: .7rem 1fr; }
    .of-thread a .of-chip { grid-column: 2; justify-self: start; }
    .of-send-row .of-btn--primary { width: 100%; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .of-btn--recording { animation: of-pulse 1.6s ease-in-out infinite; }
    @keyframes of-pulse { 50% { box-shadow: 0 0 0 5px rgba(122, 46, 46, .2); } }
  }
</style>
