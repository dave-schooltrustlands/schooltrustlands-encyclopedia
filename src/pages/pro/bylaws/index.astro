---
import ProLayout from '../../../layouts/ProLayout.astro';

export const prerender = true;
---

<ProLayout
  title="Bylaws · Pro · America's School Trust Library"
  description="The Library's adopted Bylaws now live at /bylaws; this route remains as a stable pointer for older links."
  sourceId="pro-bylaws"
  pageLabel="Bylaws"
>
  <article class="prose prose-slate max-w-none prose-a:text-blue-700 prose-a:underline">
    <p class="kicker">Institutional Records</p>
    <h1>Bylaws</h1>

    <p>
      This document has moved. The adopted Bylaws of America's School Trust
      Library, Version 7, are published in full on this site at
      <a href="/bylaws">/bylaws</a>.
    </p>

    <p>
      This route remains available for stable links from earlier Library
      drafts. For the other adopted governing instruments, see
      <a href="/governance">Governance</a>. For the record-building rules, use
      <a href="/pro/editorial-standards/">Editorial Standards</a>,
      <a href="/pro/collection-development/">Collection Development</a>, and
      <a href="/about/corrections/">Corrections</a>.
    </p>
  </article>

  <style>
    .kicker {
      font-family: var(--font-sans);
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: #A88A4E;
      margin: 0 0 0.4rem;
    }
  </style>
</ProLayout>
