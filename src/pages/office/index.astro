---
import { adminCanReadSetting } from '../../lib/office/policy';
// The private research office: the desk. A composer for a new request and the
// list of threads. Server-rendered on every visit; the gate in
// src/middleware.ts has already checked who is asking.
export const prerender = false;
import Composer from '../../components/office/Composer.astro';
import Layout from '../../layouts/OfficeLayout.astro';
import { STATUS_LABEL, defer, formatWhen, isTrue, officeEnv, officeTitle, officeUser, type RequestStatus } from '../../lib/office/config';
import { expireStale, listUsableBots, listRequests, sweep, type Row } from '../../lib/office/db';

const env = officeEnv(Astro.locals);
const user = officeUser(Astro.locals);
if (!user) return new Response('Sign-in required.', { status: 401 });

const db = env.OFFICE_DB;
await expireStale(db);
defer(Astro.locals, sweep(env));

const officeName = officeTitle(env);
const bots = user.isOwner ? await listUsableBots(db, env) : [];
// An owner sees their own threads. An admin who may read sees every thread.
const canSeeThreads = user.isOwner || user.adminCanRead;
const threads: Row[] = canSeeThreads ? await listRequests(db, user.adminCanRead ? null : user.email) : [];
const waiting = threads.filter((t) => t.owner_unread && t.owner_email === user.email).length;
---
<Layout title="Desk" officeName={officeName} user={user} page="desk" adminCanRead={adminCanReadSetting(env)}>
  <span class="of-eyebrow">Private research office</span>
  <h1 class="of-h1">{officeName}</h1>
  <p class="of-lede">
    {user.isOwner
      ? 'Ask one of the Library’s research bots for something. Type it, say it, or attach files. The answer comes back here, in a thread of its own.'
      : 'You manage this office. Requests are written by its owner.'}
  </p>

  {user.isOwner && bots.length > 0 && <Composer mode="new" canTranscribe={!!env.AI} bots={bots.map((b) => ({ id: b.id, name: b.name, description: b.description }))} />}
  {user.isOwner && bots.length === 0 && (
    <p class="of-note">No bots are switched on yet, so there is nobody to send a request to. The administrator can add them.</p>
  )}

  {canSeeThreads ? (
    <section aria-labelledby="of-threads-h">
      <h2 class="of-h2" id="of-threads-h">
        Threads
        {waiting > 0 && <span class="of-meta"> · {waiting} new {waiting === 1 ? 'reply' : 'replies'}</span>}
      </h2>
      {threads.length === 0 ? (
        <p class="of-empty">Nothing here yet. Your first request will appear in this list.</p>
      ) : (
        <ul class="of-threads">
          {threads.map((t) => (
            <li class="of-thread" data-unread={t.owner_unread && t.owner_email === user.email ? '1' : '0'}>
              <a href={`/office/${t.id}/`}>
                <span class="of-dot" aria-hidden="true"></span>
                <span class="of-thread-title">
                  {t.owner_unread && t.owner_email === user.email ? <span class="of-meta">New · </span> : null}{t.title}
                </span>
                <span class="of-chip" data-status={t.status}>{STATUS_LABEL[t.status as RequestStatus] || t.status}</span>
                <span class="of-thread-sub">
                  {t.bot_name} · {t.message_count} {t.message_count === 1 ? 'message' : 'messages'} · {formatWhen(t.updated_at, env)}
                  {t.owner_email !== user.email && <> · from {t.owner_email}</>}
                </span>
              </a>
            </li>
          ))}
        </ul>
      )}
    </section>
  ) : (
    <p class="of-note">
      Reading this office is switched off for administrators. You can still manage bots, tokens, and publication decisions on the
      <a href="/office/admin/">admin page</a>.
    </p>
  )}
</Layout>
