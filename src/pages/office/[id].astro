---
// Bob's Office: one request and its answers.
// Server-rendered on every visit. Sign-in is checked by the gate in
// src/middleware.ts; this page then checks that the thread belongs to the
// person asking. Someone else's thread and a thread that does not exist get
// the same answer.
export const prerender = false;
import Composer from '../../components/office/Composer.astro';
import Layout from '../../layouts/OfficeLayout.astro';
import { STATUS_LABEL, friendlyWhen, listOf, officeEnv, officeTitle, officeUser, shortDate, type RequestStatus } from '../../lib/office/config';
import { audit, expireStale, getThread, markRead, parseIdArray } from '../../lib/office/db';
import { isAudio, isImage } from '../../lib/office/files';
import { renderMarkdown } from '../../lib/office/markdown';
import { answerEmailStatus } from '../../lib/office/notify';
import { adminCanReadSetting } from '../../lib/office/policy';
import { canDeleteRequest, canNominate, canReadRequest, canWriteRequest, isTestThread } from '../../lib/office/rules';
import { clientIp, isId } from '../../lib/office/util';

const env = officeEnv(Astro.locals);
const user = officeUser(Astro.locals);
if (!user) return new Response('Sign-in required.', { status: 401 });

const db = env.OFFICE_DB;
const officeName = officeTitle(env);
const adminCanRead = adminCanReadSetting(env);
const id = Astro.params.id;

await expireStale(db);
const thread = isId('r', id) ? await getThread(db, id) : null;
const visible = !!thread && canReadRequest(user, thread.request);
if (!visible) Astro.response.status = 404;

const request = visible ? thread!.request : null;
const mine = !!request && canWriteRequest(user, request);
const mayDelete = !!request && canDeleteRequest(user, request, env.OFFICE_OWNER_EMAILS);
const isTest = !!request && user.isAdmin && isTestThread(request, env.OFFICE_OWNER_EMAILS);
const justSent = !!request && mine && Astro.url.searchParams.get('sent') === '1';
const helpEmail = listOf(env.OFFICE_ADMIN_EMAILS)[0] || '';
// The answer-ready email goes only to the owner, and only when email is set up.
const emailsOn = answerEmailStatus(env).ready && !!request && !isTestThread(request, env.OFFICE_OWNER_EMAILS);
const cap = (x: string): string => x.charAt(0).toUpperCase() + x.slice(1);
const mayNominate = !!request && canNominate(user, request);
if (request && mine && request.owner_unread) await markRead(db, request.id);
if (request && !mine) {
  await audit(db, { actor_kind: 'admin', actor_id: user.email, action: 'admin.thread_read', request_id: request.id, ip: clientIp(Astro.request) });
}

const status = (request?.status || 'queued') as RequestStatus;
const working = ['queued', 'claimed', 'in_progress'].includes(status);
const bn = request?.bot_name || 'The helper';
const statusLine: Record<RequestStatus, string> = {
  queued: `Waiting for ${bn} to pick this up. Helpers check for new requests from time to time; the answer will appear on this page. You do not need to keep it open.`,
  claimed: `${bn} has picked this up and is working on it. The answer will appear on this page.`,
  in_progress: `${bn} is working on this. The answer will appear on this page.`,
  answered: `${bn} has answered (below). To ask for a change or more, write back in the box at the bottom.`,
  needs_info: `${bn} has a question for you before going on. Please read it below and answer in the box at the bottom.`,
  failed:
    request?.status_note === 'lease_expired'
      ? `${bn} started this several times and did not finish. Press “Send it again” at the bottom, or email Dave.`
      : `${bn} could not finish this. Press “Send it again” at the bottom, or write back with a change.`,
};
const pubChip: Record<string, string> = { nominated: 'Offered', approved: 'Approved', rejected: 'Not taken', withdrawn: 'Taken back' };
const pubLabel: Record<string, string> = {
  nominated: 'You offered this answer to the public Library. Dave has not decided yet.',
  approved: 'Dave approved this answer for the public Library.',
  rejected: 'Dave decided not to put this answer in the public Library.',
  withdrawn: 'You took back your offer. Nothing was published.',
};
const fileLabel = (f: { kind: string; filename: string }, at: string): string =>
  f.kind === 'voice' ? `Voice note, ${shortDate(at, env)}` : f.filename;
---
<Layout title={request ? request.title : 'Not found'} officeName={officeName} user={user} page="thread" adminCanRead={adminCanRead}>
  <a class="of-back" href="/office/">&larr; Back to {officeName}</a>

  {!request && (
    <>
      <h1 class="of-h1">Nothing here</h1>
      <p class="of-lede">There is no thread at this address, or it has been deleted.</p>
    </>
  )}

  {request && thread && (
    <div data-thread data-request-id={request.id} data-version={`${request.status}|${thread.messages.length}`} data-watch={working ? '1' : '0'}>
      <header class="of-thread-head">
        <h1 class="of-h1">{request.title}</h1>
        <div class="of-row">
          {isTest && <span class="of-chip of-chip--test">Test</span>}
          <span class="of-chip" data-status={status}>{STATUS_LABEL[status]}</span>
          <span class="of-meta">Sent to {request.bot_name} {friendlyWhen(request.created_at, env)}{!mine && <> · from {request.owner_email}</>}</span>
        </div>
      </header>

      {justSent && (
        <div class="of-sent" role="status">
          <p class="of-sent-h">Sent to {request.bot_name} {friendlyWhen(request.created_at, env)}.</p>
          <p>
            The answer will appear right here, and this request is listed in {officeName} under <em>Your requests</em>.
            You can close this page and come back any time.{emailsOn && ' We will send you a short email when the answer is ready.'}
          </p>
          <p>
            Helpers work through requests as they come in, so an answer can take a while.
            {helpEmail ? <> If nothing has happened by tomorrow, email Dave at <a href={`mailto:${helpEmail}`}>{helpEmail}</a>.</> : ' If nothing has happened by tomorrow, let Dave know.'}
          </p>
          <p><a class="of-btn" href="/office/">Back to {officeName}</a></p>
        </div>
      )}
      {!justSent && <p class={`of-note ${status === 'failed' ? 'of-note--warn' : ''} ${status === 'needs_info' ? 'of-note--ask' : ''}`}>{statusLine[status]}</p>}
      <p class="of-note" data-fresh hidden>
        There is something new in this thread. <button type="button" class="of-btn of-btn--quiet" data-reload>Show it</button>
      </p>

      {thread.messages.map((m) => {
        const files = thread.files.get(m.id) || [];
        const pub = thread.publications.get(m.id);
        const fromBot = m.author_kind === 'bot';
        const who = fromBot ? request.bot_name : mine ? 'You' : m.author_id;
        const offered = files.filter((f) => f.kind === 'file');
        const included = pub ? parseIdArray(pub.attachment_ids) : [];
        return (
          <article class={`of-msg ${fromBot ? 'of-msg--bot' : 'of-msg--owner'}`} id={m.id}>
            <header class="of-msg-head">
              <span class="of-msg-who">{who}</span>
              <span class="of-meta">{cap(friendlyWhen(m.created_at, env))}</span>
              {m.kind === 'needs_info' && <span class="of-chip" data-status="needs_info">Question for you</span>}
              {m.kind === 'failure' && <span class="of-chip" data-status="failed">Did not finish</span>}
              {m.kind === 'progress' && <span class="of-chip" data-status="in_progress">Progress note</span>}
            </header>

            {m.body ? <div class="of-prose" set:html={renderMarkdown(m.body)} /> : <p class="of-meta">(No text. See the attachments.)</p>}

            {files.length > 0 && (
              <ul class="of-files" aria-label="Attachments">
                {files.map((f) => {
                  const url = `/api/office/attachments/${f.id}`;
                  const label = fileLabel(f, m.created_at);
                  return (
                    <li class="of-file">
                      <span class="of-file-name">{label}</span>
                      <span class="of-file-actions">
                        {!isAudio(f) && <a class="of-btn of-btn--small" href={url} target="_blank" rel="noopener">Open</a>}
                        <a class="of-btn of-btn--small" href={`${url}?download=1`} download={f.kind === 'voice' ? undefined : f.filename}>Save a copy</a>
                      </span>
                      {isAudio(f) && <audio controls preload="metadata" src={url} data-voice aria-label={label}></audio>}
                      {isImage(f.content_type) && (
                        <a href={url} target="_blank" rel="noopener">
                          <img class="of-thumb" src={url} alt={label} loading="lazy" />
                        </a>
                      )}
                      {f.transcript && (
                        <details class="of-transcript">
                          <summary>What the machine heard</summary>
                          <p>{f.transcript}</p>
                        </details>
                      )}
                    </li>
                  );
                })}
              </ul>
            )}

            {fromBot && m.kind === 'reply' && (pub || mayNominate) && (
              <footer class="of-msg-foot">
                {pub && (
                  <p>
                    <span class="of-chip" data-status={pub.state}>{pubChip[pub.state] || pub.state}</span>{' '}
                    {pubLabel[pub.state] || ''}
                    {pub.state === 'approved' && pub.public_url && <> <a href={pub.public_url} target="_blank" rel="noopener">See it in the Library</a>.</>}
                    {pub.decision_note && pub.state !== 'withdrawn' && <> Note: {pub.decision_note}</>}
                    {pub.state === 'nominated' && mayNominate && (
                      <button type="button" class="of-btn of-btn--quiet" data-withdraw={pub.id}>Take it back</button>
                    )}
                  </p>
                )}
                {pub && pub.state === 'approved' && included.length > 0 && (
                  <p>{included.length} {included.length === 1 ? 'file is' : 'files are'} cleared to go with it.</p>
                )}
                {mayNominate && (!pub || pub.state === 'rejected' || pub.state === 'withdrawn') && (
                  <details data-nominate={m.id}>
                    <summary>Offer this answer to the public Library</summary>
                    <p>
                      If this answer would be useful to other readers, you can offer it to the public Library website.
                      Dave reviews it first, and nothing becomes public unless he approves it. Your own messages and recordings are never included.
                    </p>
                    {offered.length > 0 && (
                      <div>
                        <span class="of-label">Files that may go with it</span>
                        {offered.map((f) => (
                          <label class="of-check"><input type="checkbox" value={f.id} data-nominate-file /> {fileLabel(f, m.created_at)}</label>
                        ))}
                      </div>
                    )}
                    <label class="of-label" for={`of-note-${m.id}`}>A note for Dave <small>(optional)</small></label>
                    <input class="of-input" id={`of-note-${m.id}`} type="text" maxlength="1000" data-nominate-note />
                    <div class="of-row of-tools">
                      <button type="button" class="of-btn" data-nominate-send>Offer it to the Library</button>
                    </div>
                  </details>
                )}
              </footer>
            )}
          </article>
        );
      })}

      <p class="of-status" data-thread-status role="status" aria-live="polite"></p>

      {mine && <Composer mode="followup" canTranscribe={!!env.AI} requestId={request.id} botName={request.bot_name} />}

      {(mine || mayDelete) && (
        <div class="of-thread-actions">
          {mine && status === 'failed' && <p><button type="button" class="of-btn of-btn--primary" data-retry>Send it again</button></p>}
          <button type="button" class="of-link-btn" data-delete>{isTest ? 'Delete this test thread' : 'Delete this request'}</button>
          <div class="of-confirm" data-delete-confirm hidden role="alertdialog" aria-labelledby="of-del-q">
            <p id="of-del-q"><strong>Delete this request and its files for good?</strong> This cannot be undone.</p>
            <p class="of-row">
              <button type="button" class="of-btn" data-delete-no>Keep it</button>
              <button type="button" class="of-btn of-btn--danger" data-delete-yes>Delete it</button>
            </p>
          </div>
        </div>
      )}
    </div>
  )}
</Layout>
