---
export const prerender = true;
import RoomLayout from '../../../layouts/RoomLayout.astro';
import ZybachNav from '../../../components/zybach/ZybachNav.astro';
import WorkingEditionBanner from '../../../components/zybach/WorkingEditionBanner.astro';
import ProvenanceBlock from '../../../components/zybach/ProvenanceBlock.astro';
import AlbertaComparison from '../../../components/zybach/AlbertaComparison.astro';
import readings from '../../../data/zybach/alberta_readings.json';
const base = 'http://www.orww.org/Alberta_Street_Project/2015_Report/';
const earlier = base + '10_References/Gardner_et_al_19920918.pdf';
const later = base + '10_References/Davis_et_al_20151020.pdf';
// Audience: students, neighbors and researchers. Help them compare the two
// public reports and form a source-supported question. No interview release.
---
<RoomLayout room="collections" title="The Alberta Street Project" subtitle="One neighborhood, two surveys · Portland, 1992 and 2015" width="full" sourceId="collections-zybach-alberta-street" parents={[{ label: 'The Zybach Collection', href: '/collections/zybach/' }]}>
  <span data-pagefind-meta="collection:zybach" hidden></span>
  <span data-pagefind-meta="series:alberta-street" hidden></span>
  <ZybachNav current="finding-aid" />
  <WorkingEditionBanner />
  <div class="alberta-opening" id="what">
    <div>
      <p class="kicker">Students studying their community</p>
      <h2>What makes a neighborhood worth remembering?</h2>
      <p class="lead">People, meeting places, businesses, trees, stories. Two teams of young Portland researchers studied the Alberta Street neighborhood twenty-three years apart. Their reports let you compare what they found, how they worked, and what they hoped would happen next.</p>
      <p>This guide takes you into the reports already published by Oregon Websites and Watersheds Project (ORWW). Start with one question below, then return with a detail from each study.</p>
      <a class="start-button" href="#compare">Compare the two surveys ↓</a>
      <p class="opening-note">For a class, a neighborhood history project, or a first visit. The reports open on ORWW’s website; the Library supplies the guide and your comparison sheet.</p>
    </div>
    <aside class="years" aria-label="The two study years">
      <p><strong>1992</strong><span>A neighborhood inventory</span></p>
      <div class="year-bridge"><span>23 years</span><span aria-hidden="true">↓</span></div>
      <p><strong>2015</strong><span>A return to the same community</span></p>
      <a href="#originals">Meet the research teams ↓</a>
    </aside>
  </div>

  <section id="originals" class="report-section" aria-labelledby="reports-title">
    <h2 id="reports-title">The two reports</h2>
    <div class="report-grid">
      <article class="report-card">
        <p class="kicker">The first survey · 1992</p>
        <h3>Alberta Street Cultural Resource Inventory with Recommendations</h3>
        <p>Gardner and colleagues describe the area’s history and resources, map what they found, and recommend neighborhood improvements. Begin with the project’s purposes on printed page 1.</p>
        <a class="report-button" href={earlier + '#page=17'} target="_blank" rel="noopener">Read the 1992 report · PDF ↗</a>
        <details><summary>Authors and edition</summary><p>Deborah Gardner, Andrew Clark, Delana Foster, Saretta Horn, Monica Owens, Samona Stroud and Tyran Ward. Report submitted to Urban Forestry, Inc., Portland, 1992.</p><p>Names follow the <a href={earlier + '#page=7'} target="_blank" rel="noopener">signed title page (PDF page 7)</a>. The scan also contains a front cover with six names and a later, 2011 reprint title page with different credits. The original pages remain as published.</p></details>
      </article>
      <article class="report-card">
        <p class="kicker">The return study · 2015</p>
        <h3>Alberta Street Cultural Resource Inventory With Recommendations</h3>
        <p>Davis and colleagues revisit the neighborhood and the earlier recommendations. Their report explains the later study’s methods and limits, helping readers judge what can be compared.</p>
        <a class="report-button" href={later + '#page=1'} target="_blank" rel="noopener">Read the 2015 report · PDF ↗</a>
        <details><summary>Authors and edition</summary><p>Joshua Davis, Olabode Arigbon, Dominic Williams, Malachi Mandley and Cade May. October 20, 2015. The report credits ORWW and World Arts Foundation, Inc.; its methods chapter is by Bob Zybach.</p><p>Use the <a href={later + '#page=10'} target="_blank" rel="noopener">contents (PDF pages 10–11)</a> to explore beyond this guide.</p></details>
      </article>
    </div>
    <p class="source-help">The 1992 report is a scan; text search may not work. Links below give both the printed page and its position in the PDF. If your viewer ignores the jump, enter the PDF page number in its page control.</p>
  </section>

  <AlbertaComparison questions={readings.questions} />

  <section class="beyond-guide" aria-labelledby="further-title">
    <h2 id="further-title">Take the question further</h2>
    <div class="further-grid">
      <article><h3>Study how an interview works</h3><p>What would a question invite a resident to remember? Compare the two reports’ interview questions before drafting a question of your own.</p><ul>{readings.interviewForms.map(s => <li><a href={s.href} target="_blank" rel="noopener">{s.label} ↗</a></li>)}</ul></article>
      <article><h3>Follow Bob’s method into another landscape</h3><p>In Soap Creek Valley, memories of a place meet printed sources and landscape evidence. Try a short reading and listening experience, or read Bob’s account of how his collection began.</p><ul><li><a href="/collections/zybach/soap-creek/listen/rowley-hardwoods/">Marvin Rowley: hardwoods, soil and a fallen tree</a></li><li><a href="/participate/how-a-collection-comes-in/the-conversation/">Bob and Dave: how a collection comes in</a></li></ul></article>
    </div>
    <p class="historical-note">Read these reports as records of their times. Names, descriptions, business listings and recommendations may have changed. The studies’ language and interpretations belong to their authors; a historical listing is not present-day visiting or safety advice.</p>
  </section>

  <section class="inventory-section" id="inventory" aria-labelledby="inventory-title">
    <h2 id="inventory-title">What is available, and where</h2>
    <dl class="availability">
      <div><dt>Read now</dt><dd>The complete 1992 and 2015 reports at ORWW. This Library page offers reading paths and a comparison sheet; it does not republish either report.</dd></div>
      <div><dt>Supporting files</dt><dd>The <a href={base + 'index.html'}>2015 project contents and bibliography</a> link to source folders as well as reports. Some links open directory listings of images and working material, rather than a readable chapter.</dd></div>
      <div><dt>Recordings</dt><dd>As of September 14, 2026, recordings have been identified in materials shared by Oregon State University. Copying and permissions review are in progress. The recordings are not available for playback here.</dd></div>
    </dl>
    <h3 id="gaps">What still needs work</h3>
    <p>Matching recordings to interviews, completing and verifying preservation copies, and checking the permissions for public use remain separate tasks. Finding a recording is a useful step; it does not establish permission to publish it.</p>
    <h3 id="next">Care for a community’s record</h3>
    <p>The reports and interviews involve several creators and community members. The Library keeps their credits and source distinctions visible. The <a href="/collections/zybach/rights/#alberta-street">Alberta Street rights statement</a> explains the current access limits.</p>
    <ProvenanceBlock items={[
      { label: 'Source reports', value: 'Gardner and colleagues (1992); Davis and colleagues (2015). Original report pages and ORWW’s bibliography supply the credits and reading destinations.' },
      { label: 'Published originals', value: 'Alberta Street Project at ORWW', href: 'http://www.orww.org/Alberta_Street_Project/' },
      { label: 'This guide', value: 'Original editorial navigation and reading questions prepared by America’s School Trust Library with Codex assistance, September 14, 2026. No report or interview is republished here.' },
      { label: 'Rights', value: 'Source materials have their own authors and rights. See the collection’s item-specific statements.', href: '/collections/zybach/rights/' },
    ]} />
    <p class="see-also"><a href="/collections/zybach/">The collection</a> · <a href="/collections/zybach/start-here/">Find another starting point</a> · <a href="/collections/zybach/errata/#log">Corrections to this collection</a> · <a href={`/correct${Astro.url.pathname}`}>Submit a correction</a></p>
  </section>
</RoomLayout>
<style>
  .alberta-opening,.report-section,.beyond-guide,.inventory-section{max-width:76rem;margin:2rem auto;line-height:1.65;color:var(--deep-navy,#14243c)}
  .alberta-opening{display:grid;grid-template-columns:minmax(0,2.1fr) minmax(220px,1fr);gap:3rem;padding-bottom:2rem;border-bottom:1px solid #cbd1cc}
  .kicker{font:700 .76rem/1.5 var(--font-sans);letter-spacing:.08em;text-transform:uppercase;color:#665121;margin:0 0 .6rem}
  .alberta-opening h2{font-size:clamp(1.8rem,3.8vw,3rem);line-height:1.13;margin:.5rem 0 1.2rem;max-width:20ch}
  .lead{font-size:1.17rem}.alberta-opening p{max-width:66ch}.opening-note,.source-help,.historical-note{font:.9rem/1.6 var(--font-sans);color:#4b5d66}
  .start-button,.report-button{display:inline-block;background:#193346;color:#fff!important;padding:.7rem 1rem;border-radius:3px;font:650 .95rem/1.5 var(--font-sans);text-decoration:none;margin:.5rem 0}
  .years{background:#f2ede0;border:1px solid #d7cdb7;padding:1.8rem;text-align:center;align-self:start}.years p{margin:0}.years strong{display:block;font:4rem/1.15 Georgia,serif;color:#193346}.years span{display:block;font:.9rem/1.5 var(--font-sans)}
  .year-bridge{margin:1rem 0;color:#665121}.year-bridge span:last-child{font-size:1.8rem}.years a{display:inline-block;font:.85rem/1.5 var(--font-sans);margin-top:1.3rem}
  .report-section h2,.beyond-guide h2,.inventory-section h2{font-size:1.7rem;line-height:1.25}.report-grid,.further-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.2rem}
  .report-card{background:#fff;border:1px solid #c3ccc8;padding:1.5rem;min-width:0}.report-card h3{font-size:1.5rem;line-height:1.3;margin:.4rem 0 1rem}.report-card details{font-size:.92rem;border-top:1px solid #d6dbd7;margin-top:1rem;padding-top:.8rem}.report-card summary{font-family:var(--font-sans);font-weight:650;cursor:pointer}.report-card details p{margin:.8rem 0}
  .source-help{max-width:92ch;margin:1rem 0}.beyond-guide{border-top:1px solid #cbd1cc;padding-top:1.5rem}.further-grid article{padding-right:1.5rem}.further-grid h3{font-size:1.25rem;line-height:1.35}.further-grid ul{padding-left:1.25rem}.further-grid li{margin:.7rem 0}.historical-note{max-width:90ch;margin:1.5rem 0}
  .inventory-section{max-width:76ch;margin-top:3rem;border-top:1px solid #cbd1cc;padding-top:1.5rem}.inventory-section h3{font-size:1.2rem}.availability{margin:1rem 0 2rem}.availability>div{display:grid;grid-template-columns:9rem 1fr;gap:1rem;padding:1rem 0;border-bottom:1px solid #d6dbd7}.availability dt{font:700 .9rem/1.6 var(--font-sans)}.availability dd{margin:0}.see-also{font-size:.9rem}
  :is(.alberta-opening,.report-section,.beyond-guide,.inventory-section) a:focus-visible,.report-card summary:focus-visible{outline:3px solid #1e718d;outline-offset:3px}
  @media(max-width:800px){.alberta-opening{grid-template-columns:1fr;gap:1.4rem}.years{display:flex;flex-wrap:wrap;justify-content:space-around;align-items:center;gap:1rem;padding:1.3rem}.years strong{font-size:2.8rem}.year-bridge span:last-child{display:none}.years a{width:100%;margin-top:0}.report-grid,.further-grid{grid-template-columns:1fr}.alberta-opening h2{max-width:24ch}}
  @media(max-width:440px){.report-card{padding:1.1rem}.availability>div{grid-template-columns:1fr;gap:.3rem}.years{gap:.6rem}.years strong{font-size:2.3rem}.years span{font-size:.8rem}}
</style>
