---
export const prerender = true;

import SoapCreekPage from '../../../../../components/zybach/soapcreek/SoapCreekPage.astro';
import ZybachMap from '../../../../../components/zybach/soapcreek/ZybachMap.astro';
import MapList from '../../../../../components/zybach/soapcreek/MapList.astro';
import CitationBlock from '../../../../../components/zybach/soapcreek/CitationBlock.astro';
import ProvenanceBlock from '../../../../../components/zybach/soapcreek/ProvenanceBlock.astro';
import ContentNote from '../../../../../components/zybach/soapcreek/ContentNote.astro';
import { autotour, autotourStops, gazetteer } from '../../../../../components/zybach/soapcreek/data';
import { tourHref, stopHref, placeHref, folioId, folioLabel } from '../../../../../components/zybach/soapcreek/links';

const a: any = autotour ?? {};
const url = tourHref();
const stops = [...autotourStops].sort((x,y) => Number(x.stop_number)-Number(y.stop_number));

/** Coordinates for a stop: the record's own, else the gazetteer entry. */
function stopLonLat(s: any): [number, number] | null {
  if (typeof s?.lon === 'number' && typeof s?.lat === 'number') return [s.lon, s.lat];
  const ll = s?.lat_lon;
  if (Array.isArray(ll) && ll.length === 2) {
    const [x, y] = ll as [number, number];
    // Records store [lat, lon]; GeoJSON wants [lon, lat].
    return Math.abs(x) > Math.abs(y) ? [x, y] : [y, x];
  }
  if (ll && typeof ll === 'object' && typeof ll.lat === 'number' && typeof ll.lon === 'number') {
    return [ll.lon, ll.lat];
  }
  const g = gazetteer.find((p) => p.auto_tour_stop === s?.stop_number);
  if (g && typeof g.lon === 'number' && typeof g.lat === 'number') return [g.lon, g.lat];
  return null;
}

const stopFeatures = {
  type: 'FeatureCollection',
  features: stops
    .map((s: any) => {
      const ll = stopLonLat(s);
      if (!ll) return null;
      return {
        type: 'Feature',
        geometry: { type: 'Point', coordinates: ll },
        properties: {
          kind: 'auto-tour-stop',
          stop_number: Number(s.stop_number),
          title: s.title_in_contents ?? s.title ?? `Stop #${s.stop_number}`,
          subtitle: s.theme ?? '',
          href: stopHref(s.stop_number),
        },
      };
    })
    .filter(Boolean),
};

const centre =
  (stopFeatures.features[0] as any)?.geometry?.coordinates ?? [-123.29, 44.72];

/**
 * The whole booklet, page by page. `pages_text` is the printed text keyed by
 * folio, so every `#pNN` a citation points at exists on this page.
 */
const pageOrder = (k: string) =>
  /^\d+$/.test(k) ? Number(k) : k === 'front-cover' ? -1 : 9999;
const bookletPages: Array<{ page: string; entries: any[] }> = Object.entries(
  (a.pages_text ?? {}) as Record<string, any[]>,
)
  .map(([page, entries]) => ({ page, entries: (entries ?? []).slice() }))
  .sort((x, y) => pageOrder(x.page) - pageOrder(y.page));

const fm: any = a.front_matter ?? {};
const route: any = a.route ?? {};
const notes: any[] = (a.content_notes ?? []).filter((n: any) => n && (n.display_note || n.note));
const source: any = a.source ?? {};
const photographs: any[] = a.photographs ?? [];
const sourcesCited: any = a.sources_cited ?? null;

const parents = [
  { label: 'The Zybach Collection', href: '/collections/zybach/' },
  { label: 'Soap Creek Valley', href: '/collections/zybach/soap-creek/' },
];

const fmOrder: Array<[string, string]> = [
  ['cover_text', 'Cover, as printed'],
  ['copyright_block', 'Copyright, as printed'],
  ['acknowledgements', 'Acknowledgments'],
  ['project_statement', 'Soap Creek Valley History Project'],
  ['introduction', 'Introduction'],
  ['driving_safety_note', 'A note on driving'],
  ['map_note', 'The tour map'],
];
const frontMatter = fmOrder
  .filter(([k]) => typeof fm[k] === 'string' && fm[k].trim())
  .map(([k, label]) => ({ label, text: fm[k] as string }));

const mileage: any[] = route.mileage_table ?? [];
---

<SoapCreekPage title={a.title ?? 'Historic Soap Creek Valley Auto Tour'}
  subtitle="Explore the valley through eleven stops in Bob Zybach’s 1989 tour."
  parents={parents} sourceId="zybach-sc-autotour-1989" width="full">
  <p class="tour-citation">{a.citation_canonical}</p>
  <p>From Berry Creek to the Old-Growth Trail, the tour connects places with stories of trapping, settlement, farming and forestry. Choose a numbered stop to see the original illustrated pages and read its account.</p>
  <p class="tour-links"><a href={`${tourHref()}booklet/`}>Read the original booklet</a> · <a href={source.public_url}>Scanned booklet (PDF)</a> · <a href={`${tourHref()}booklet/#p31`}>Additional sources</a></p>
  <p class="tour-note">Locations are approximate. Mileage is cumulative from the Peavy Arboretum entrance along the 1989 route; it is historical information, not current driving or access advice.</p>
  <section aria-label="Interactive tour map">
    <ZybachMap id="auto-tour-map" center={centre as [number,number]} zoom={11} features={stopFeatures} height="440px" fit={true} />
  </section>
  <section aria-labelledby="the-stops">
    <h2 id="the-stops">Choose a stop</h2>
    <ol class="tour-stop-index">
      {stops.map((s:any) => <li value={Number(s.stop_number)}>
        <a href={stopHref(s.stop_number)}>{String(s.title_in_contents ?? s.title).replace(/^Stop\s*#?\d+\s*[.:—–-]?\s*/i,'')}</a>
        <span>{s.cumulative_miles != null ? `${Number(s.cumulative_miles).toFixed(1)} miles` : ''}{s.page != null ? ` · printed page ${s.page}` : ''}</span>
      </li>)}
    </ol>
  </section>
  <details class="tour-source-note"><summary>About this edition and map</summary>
    <p>The complete historical text, acknowledgments, map credits and both mileage routes remain in the <a href={`${tourHref()}booklet/`}>original booklet</a>. The numbered map connects those stops with the Library’s place and interview records.</p>
    {notes.map((n:any) => <ContentNote text={`${n.display_note ?? n.note}${n.page ? ` (printed page ${n.page})` : ''}`} level="item" />)}
    <p><a href="/collections/zybach/provenance/">Source history</a> · <a href="/collections/zybach/how-to-cite/">How to cite</a> · <a href="/collections/zybach/rights/">Use or removal requests</a></p>
  </details>
  {bookletPages.map(g => <span class="legacy-folio" id={folioId(g.page)} data-booklet-folio><a href={`${tourHref()}booklet/#${folioId(g.page)}`}>Read printed {folioLabel(g.page)} in the original booklet</a></span>)}

  <span class="legacy-folio" id="tour-front-matter" data-booklet-folio><a href={`${tourHref()}booklet/#tour-front-matter`}>Open this section in the original booklet</a></span><span class="legacy-folio" id="directions" data-booklet-folio><a href={`${tourHref()}booklet/#directions`}>Open this section in the original booklet</a></span><span class="legacy-folio" id="mileage" data-booklet-folio><a href={`${tourHref()}booklet/#mileage`}>Open this section in the original booklet</a></span><span class="legacy-folio" id="tour-photographs" data-booklet-folio><a href={`${tourHref()}booklet/#tour-photographs`}>Open this section in the original booklet</a></span><span class="legacy-folio" id="booklet" data-booklet-folio><a href={`${tourHref()}booklet/#booklet`}>Open this section in the original booklet</a></span><span class="legacy-folio" id="tour-original" data-booklet-folio><a href={`${tourHref()}booklet/#tour-original`}>Open this section in the original booklet</a></span>
</SoapCreekPage>
<script>
  function forwardBookletFolio(){
    const id=window.location.hash.slice(1);
    if(id && document.getElementById(id)?.hasAttribute('data-booklet-folio')) window.location.replace('/collections/zybach/soap-creek/auto-tour/booklet/#'+encodeURIComponent(id));
  }
  forwardBookletFolio();window.addEventListener('hashchange',forwardBookletFolio);
</script>
<style>
  .tour-citation{font:.9rem/1.5 var(--font-sans);margin:1rem 0;color:#5b5549}
  .tour-links{font:1rem/1.7 var(--font-sans)}.tour-note{font:.9rem/1.5 var(--font-sans);color:#5b5549}
  .tour-stop-index{padding-left:2rem;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 2.5rem;list-style:decimal}
  .tour-stop-index li{padding:.65rem 0;border-bottom:1px solid #d8d1c2;break-inside:avoid}
  .tour-stop-index li::marker{font-weight:bold;color:#7a2e2e}.tour-stop-index a{font-size:1.05rem}.tour-stop-index span{display:block;font:.875rem/1.5 var(--font-sans);color:#5b5549;margin-top:.2rem}
  .tour-source-note{margin-top:2rem;font-size:.95rem}.tour-source-note summary{cursor:pointer;font-weight:600}
  .legacy-folio{display:none}.legacy-folio:target{display:block}
  @media(max-width:650px){.tour-stop-index{grid-template-columns:1fr}}
</style>
