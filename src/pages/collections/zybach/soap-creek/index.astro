---
export const prerender = true;

import { mirrored } from '../../../../components/zybach/_data';
import RoomLayout from '../../../../layouts/RoomLayout.astro';
import WorkingEditionBanner from '../../../../components/zybach/WorkingEditionBanner.astro';
import ZybachNav from '../../../../components/zybach/ZybachNav.astro';
import ZybachMap from '../../../../components/zybach/soapcreek/ZybachMap.astro';
import ContentNote from '../../../../components/zybach/soapcreek/ContentNote.astro';
import Opening from '../../../../components/zybach/frontdoor/Opening.astro';
import Plate from '../../../../components/zybach/frontdoor/Plate.astro';
import Voices from '../../../../components/zybach/frontdoor/Voices.astro';
import CoverShelf from '../../../../components/zybach/frontdoor/CoverShelf.astro';
import { allPortraits } from '../../../../components/zybach/_data';
import Measure from '../../../../components/zybach/frontdoor/Measure.astro';
import AboutStrip from '../../../../components/zybach/frontdoor/AboutStrip.astro';
import {
  monographs,
  gazetteer,
  valleyGeoJSON,
  outsideValleyCount,
  people,
  chronology,
  thesis,
  autotour,
  autotourStops,
  contentNotes,
  seriesIndexMeta,
  dataReady,
} from '../../../../components/zybach/soapcreek/data';
import {
  thesisHref,
  tourHref,
  stopHref,
  indexHref,
  placesHref,
  peopleHref,
  timelineHref,
  personHref,
  periodHref,
  monoHref,
  displayNarrators,
} from '../../../../components/zybach/soapcreek/links';

const narrators = people
  .filter((p) => p.is_narrator || (p.roles ?? []).includes('narrator'))
  .sort((a, b) =>
    (a.sort_name ?? a.display_name ?? '').localeCompare(b.sort_name ?? b.display_name ?? ''),
  );

const geocoded = gazetteer.filter((p) => typeof p.lat === 'number' && typeof p.lon === 'number');
const periods = (chronology.periods ?? []).filter((p) => (p.count ?? p.entries?.length ?? 0) > 0);
const totalTimelineEntries = periods.reduce((n, p) => n + (p.count ?? p.entries?.length ?? 0), 0);

const pagesPrinted = monographs.reduce((n, m) => n + (Number(m.pages_printed) || 0), 0);
const indexRefs = seriesIndexMeta?.counts?.refs ?? 0;
const indexHeadings = seriesIndexMeta?.counts?.entries ?? 0;
const photographCount = monographs.reduce((n, m) => n + (m.photographs?.length ?? 0), 0);

/* The shelf: every book, in printed order, with the person who talks in it and
   what the book itself says they did. Covers come from the creator's own site. */
const sentenceCase = (s: string) => (s ? s.charAt(0).toUpperCase() + s.slice(1) : s);

/* A handful of title pages are set in full capitals. Where that is all the
   title is, the person's own name as the collection records it is shown
   instead; nothing else about the title is touched. */
const titleOf = (m: (typeof monographs)[number]) => {
  const printed = (m.title ?? '').replace(/\s+/g, ' ').trim();
  return /[a-z]/.test(printed) ? printed : (m.narrators?.[0]?.display_name ?? printed);
};

const shelf = monographs.map((m) => {
  const title = titleOf(m);
  const titleWords = new Set(title.toLocaleLowerCase().match(/[a-z]+/g) ?? []);
  const additionalPeople = (m.narrators ?? [])
    .map(n => n.display_name).filter(Boolean)
    .filter(name => {
      const words = String(name).toLocaleLowerCase().match(/[a-z]+/g) ?? [];
      return !words.length || !titleWords.has(words[0]) || !titleWords.has(words[words.length - 1]);
    });
  const role = (m.narrators ?? [])
    .map((n) => n.profession)
    .filter(Boolean)
    .join('; ');
  return {
    href: m.href ?? monoHref(m.slug),
    img: m.thumb_url ?? m.cover_url ?? null,
    number: m.number != null ? `#${String(m.number).padStart(2, '0')}` : '',
    title,
    subtitle: m.subtitle ?? null,
    year: m.year_printed ?? null,
    people: additionalPeople.length ? additionalPeople.join(' and ') : null,
    role: null,
  };
});

/* Three passages, verbatim, each checked against the transcript and each
   linked to the printed page it stands on. None is on a held page. */
const QUOTES = [
  {
    text:
      "Of course there were a few hazards, such as a frozen water pump, getting poison oak from carrying in wood from the woodshed, oiling the schoolhouse floor, and I might add, an unexpected visit from the County School Superintendent at least once a year. The good old days when parents didn't come to school to tell you how to teach!",
    speaker: 'Maxine Dickey',
    role: 'Schoolteacher, Berry Creek School, 1938–1940',
    source: 'Monograph #03, page 59',
    href: '/collections/zybach/soap-creek/m03-dickey/b-appendix-b-school-day-memories/#p59',
  },
  {
    text:
      "No, it wouldn't bother me because there is no sentimental value left to that out there. . . It isn't the same country as it was before Camp Adair went in.",
    speaker: 'Velma Carter Rawie',
    role: 'Farm wife and dairy farmer; store clerk',
    source: 'Monograph #10, page 43',
    href: '/collections/zybach/soap-creek/m10-rawie/08-farm-life-and-wildlife/#p43',
  },
  {
    text:
      'Yes, we were going to go completely across the forest in ten years, and do thinning, salvaging, whatever was necessary on this first time. And it just was an unmanaged forest—I mean, nothing. It was just as we’d purchased it, and, like I say, it was anything from clearcut to real old-growth patches.',
    speaker: 'Marvin Rowley',
    role: 'Manager of the OSU Research Forests, 1946–1986',
    source: 'Monograph #15, page 47',
    href: '/collections/zybach/soap-creek/m15-rowley/part-iv-february-7-1979/#p47',
  },
];

/* The map's equivalent list, grouped the way the map's colours group it. The
   map is a convenience; this is the record. */
const KIND_LABELS: Record<string, string> = {
  'auto-tour-stop': 'Auto Tour stops',
  'narrator-home': 'Narrator home sites',
  home: 'Narrator home sites',
  settlement: 'Settlements and communities',
  community: 'Settlements and communities',
  school: 'Schools',
  cemetery: 'Cemeteries',
  stream: 'Streams',
  creek: 'Streams',
  river: 'Streams',
  ridge: 'Ridges, peaks and buttes',
  peak: 'Ridges, peaks and buttes',
  butte: 'Ridges, peaks and buttes',
  mountain: 'Ridges, peaks and buttes',
  valley: 'Valleys',
  road: 'Roads',
  farm: 'Farms and ranches',
  ranch: 'Farms and ranches',
  mill: 'Mills',
};
const mapPoints = (valleyGeoJSON.features ?? []).filter(
  (f: any) => f?.geometry?.type === 'Point',
);
const mapGroups = (() => {
  const byLabel = new Map<string, any[]>();
  for (const f of mapPoints) {
    const kind = String(f?.properties?.kind ?? 'other');
    const label = KIND_LABELS[kind] ?? (kind === 'other' ? 'Other places' : kind);
    if (!byLabel.has(label)) byLabel.set(label, []);
    byLabel.get(label)!.push(f);
  }
  const first = ['Auto Tour stops', 'Narrator home sites'];
  const rest = [...byLabel.keys()].filter((l) => !first.includes(l)).sort();
  return [...first.filter((l) => byLabel.has(l)), ...rest].map((label) => ({
    label,
    items: (byLabel.get(label) ?? [])
      .map((f: any) => ({
        title: String(f.properties?.title ?? f.properties?.name ?? 'Unnamed place'),
        subtitle: (f.properties?.subtitle ?? null) as string | null,
        href: (f.properties?.href ?? null) as string | null,
      }))
      .sort((a: { title: string }, b: { title: string }) => a.title.localeCompare(b.title, undefined, { numeric: true })),
  }));
})();

const MEASURE = [
  { n: monographs.length, label: 'printed books' },
  { n: pagesPrinted, label: 'printed pages' },
  { n: narrators.length, label: 'people interviewed' },
  { n: gazetteer.length, label: 'places named' },
  { n: indexHeadings, label: 'index headings' },
  { n: indexRefs, label: 'index references' },
  { n: totalTimelineEntries, label: 'dated statements' },
  { n: photographCount, label: 'photographs described' },
];

const parents = [{ label: 'The Zybach Collection', href: '/collections/zybach/' }];
---

<RoomLayout room="collections" title="Soap Creek Valley: Oral Histories and Landscape History"
  subtitle="Fifteen oral histories of the people who farmed, logged, taught and kept house in one Oregon valley."
  width="full" parents={parents} sourceId="zybach-soap-creek-series">
  <Fragment slot="before-title"><ZybachNav current="soap-creek" /><p class="kicker">The Zybach Collection</p></Fragment>
  <span data-pagefind-meta="series:soap-creek" hidden></span><span data-pagefind-filter="series:soap-creek" hidden></span>
  <span data-pagefind-meta="collection:zybach" hidden></span>
  <div class="sc-introduction">
    <p>North of Corvallis, Oregon, Soap Creek Valley holds the history of farms, one-room schools, sawmills, Camp Adair and university research forests. Twenty-one people recall that changing landscape in interviews recorded between 1975 and 1995.</p>
    <p>Bob Zybach’s <a href={`${thesisHref()}#methodology`}>research method</a> brings residents’ memories together with photographs, maps, historical records and observations of the valley itself. Interviewees had lived or worked here and knew its farms, forests and communities firsthand. The transcripts were reviewed, edited and indexed by names, places and subjects. That <a href={indexHref()}>common index</a> lets readers follow a place or activity across several people’s accounts and compare their memories with other evidence. The aim was to understand how the valley’s forests and open lands changed, and why.</p>
    <p>Two works connect these personal accounts to the larger landscape. Zybach’s <a href={tourHref()}><cite>Historic Soap Creek Valley Auto Tour</cite></a> (1989) links historical themes to eleven places in the valley. His thesis, <a href={thesisHref()}><cite>Using Oral Histories to Document Changing Forest Cover Patterns: Soap Creek Valley, Oregon, 1500–1999</cite></a> (1999), examines oral history as a way to reconstruct forest change and understand its causes.</p>
    <figure>
      <img src={mirrored("http://www.nwmapsco.com/ZybachB/Oral_Histories/Soap_Creek_Valley/Soap_Creek_Valley-7.jpg")} alt="The Moore family farm and open hills of Soap Creek Valley" width="504" height="345" loading="eager" />
      <figcaption>Moore family farm on Soap Creek, about 1899 or 1900. Photograph by Samuel H. Moore. Courtesy Myra Moore Lauridson and the Soap Creek Schoolhouse Foundation.</figcaption>
    </figure>
  </div>
  <section aria-labelledby="the-shelf">
    <h2 id="the-shelf">The fifteen books</h2>
    <p class="sc-fd-para">Published by Oregon State University Research Forests and the College of Forestry, 1990–2009.</p>
    {monographs.length > 0 ? (
      <CoverShelf
        items={shelf}
      />
    ) : (
      <p class="sc-fd-empty">The shelf is empty until the book records are generated.</p>
    )}
  </section>

  <section aria-labelledby="the-narrators">
    <h2 id="the-narrators">The people</h2>

    {allPortraits.length > 0 && (
      <ul class="sc-fd-portraits" aria-label="Photographs of the narrators as printed in the monographs">
        {allPortraits.map((pt) => {
          const m = monographs.find((x) => x.slug === pt.slug);
          return (
            <li>
              <a href={m?.href ?? monoHref(pt.slug)} title={pt.who ?? undefined}>
                <img src={pt.file} alt={pt.who ? `${pt.who}, as printed in Monograph #${String(pt.number).padStart(2, '0')}` : `Photograph printed in Monograph #${String(pt.number).padStart(2, '0')}`} loading="lazy" decoding="async" />
              </a>
              <span>#{String(pt.number).padStart(2, '0')}</span>
            </li>
          );
        })}
      </ul>
    )}
    <p class="sc-fd-caption">Photographs from twelve of the books; each book identifies the people pictured.</p>
    <p class="sc-fd-more"><a href={peopleHref()}>Everyone named in the series</a></p>
  </section>

  <Voices
    heading="What they said"
    headingId="voices"
    quotes={QUOTES}
    lede="Each quotation links to the original passage in its book."
  />


  <aside class="rowley-listening-invite" aria-label="Example of exploring a question">
    <p class="rowley-listening-label">An example of a question you can explore</p>
    <h2><a href="/collections/zybach/soap-creek/listen/rowley-hardwoods/">What can a fallen tree tell you?</a></h2>
    <p>Follow Bob Zybach and Marvin Rowley’s discussion of hardwoods and soil through the printed words, a photograph, a place and the archive recording.</p>
  </aside>
  <section aria-labelledby="the-ground">
    <h2 id="the-ground">Explore the valley</h2>
    <p class="sc-fd-para">Select a place to find the people and passages connected with it. The map includes the 1989 tour stops, home sites and other named places.</p>

    {valleyGeoJSON.features.length > 0 ? (
      <>
        <ZybachMap
          id="soap-creek-series-map"
          center={[-123.25, 44.7]}
          zoom={11}
          features={valleyGeoJSON}
          height="500px"
          basemap="topo"
          fit={true}
        />

        <details class="sc-fd-maplist">
          <summary>Everything on this map ({mapPoints.length})</summary>
          {mapGroups.map((g) => (
            <div class="sc-fd-maplist__group">
              <h3>{g.label} <span>({g.items.length})</span></h3>
              <ul>
                {g.items.map((i) => (
                  <li>
                    {i.href ? <a href={i.href}>{i.title}</a> : <span>{i.title}</span>}
                    {i.subtitle && <span class="sub">{i.subtitle}</span>}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </details>

        {outsideValleyCount > 0 && (
          <p class="sc-fd-note">
            {outsideValleyCount} further places the narrators named lie outside
            the valley — Portland, the coast, the places they came from and went
            to. They are on the <a href={placesHref()}>places index</a>.
          </p>
        )}
      </>
    ) : (
      <p class="sc-fd-empty">The places list has not been generated yet.</p>
    )}
  </section>


  <p class="sc-fd-edition"><a href="/collections/zybach/soap-creek/about/">About this edition and its sources</a> · <a href="/collections/zybach/how-to-cite/">How to cite</a> · <a href="/collections/zybach/rights/">Use or removal requests</a></p>
</RoomLayout>
<style>

  .rowley-listening-invite{border:1px solid #b9cbbf;border-left:4px solid #365b43;border-radius:6px;background:#edf3ee;padding:1.15rem 1.4rem;margin:1.5rem 0;max-width:78ch}
  .rowley-listening-invite h2{font-size:1.4rem;line-height:1.3;margin:.4rem 0}.rowley-listening-invite p{line-height:1.65;margin:.5rem 0}.rowley-listening-invite .rowley-listening-label{font:700 .9rem/1.5 var(--font-sans,sans-serif);color:#455b4c}.rowley-listening-invite>a{display:inline-block;margin-top:.35rem}

  .sc-fd-para {
    max-width: none;
    font-size: 1rem;
    line-height: 1.68;
  }
  .sc-fd-more {
    font-family: var(--font-sans);
    font-size: 0.88rem;
  }
  .sc-fd-note {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    line-height: 1.55;
    color: #6b6355;
    max-width: 64ch;
  }
  .sc-fd-empty {
    margin: 2rem 0;
    padding: 1rem;
    border: 1px dashed var(--rule-border, #d8d1c2);
    color: #6b6355;
    font-size: 0.9rem;
  }

  /* Who talked */
  .sc-fd-people {
    list-style: none;
    margin: 1.25rem 0;
    padding: 0;
    columns: 2 18rem;
    column-gap: 2.5rem;
  }
  .sc-fd-people li {
    break-inside: avoid;
    padding: 0.5rem 0;
    border-bottom: 1px solid #ece5d5;
  }
  .sc-fd-people a {
    font-family: var(--font-serif, Georgia, serif);
    font-size: 1rem;
    color: var(--deep-navy, #14243c);
  }
  .sc-fd-people__meta {
    display: block;
    margin-top: 0.1rem;
    font-family: var(--font-sans);
    font-size: 0.76rem;
    line-height: 1.45;
    color: #6b6355;
  }

  /* The map's equivalent list */
  .sc-fd-maplist {
    margin: 0.75rem 0 1.25rem;
    font-family: var(--font-sans);
    font-size: 0.85rem;
  }
  .sc-fd-maplist summary {
    cursor: pointer;
    font-weight: 600;
    color: var(--trust-blue, #1b3252);
  }
  .sc-fd-maplist__group h3 {
    margin: 1.1rem 0 0.25rem;
    font-family: var(--font-sans);
    font-size: 0.76rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #6b6355;
  }
  .sc-fd-maplist__group h3 span {
    color: #a39a88;
    font-weight: 400;
  }
  .sc-fd-maplist ul {
    list-style: none;
    margin: 0;
    padding: 0;
    columns: 3 14rem;
    column-gap: 2rem;
  }
  .sc-fd-maplist li {
    break-inside: avoid;
    margin-bottom: 0.3rem;
    line-height: 1.4;
  }
  .sc-fd-maplist .sub {
    display: block;
    font-size: 0.74rem;
    color: #8a8172;
  }

  /* Tour and thesis */
  .sc-fd-cards {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fit, minmax(19rem, 1fr));
    margin: 1.25rem 0;
  }
  .sc-fd-card {
    border: 1px solid var(--rule-border, #d8d1c2);
    background: var(--linen-card, #fffdf7);
    padding: 1rem 1.15rem 1.15rem;
    border-radius: 3px;
  }
  .sc-fd-card h3 {
    margin: 0.2rem 0 0.5rem;
    font-size: 1.05rem;
    line-height: 1.3;
  }
  .sc-fd-card p {
    font-size: 0.95rem;
    line-height: 1.6;
  }
  .sc-fd-stops {
    margin: 0.6rem 0 0;
    padding-left: 1.2rem;
    font-size: 0.88rem;
    line-height: 1.5;
  }
  .sc-fd-canonical {
    margin-top: 0.75rem;
    padding-left: 0.85rem;
    border-left: 3px solid var(--old-gold, #a87f2c);
    font-family: var(--font-serif, Georgia, serif);
    font-size: 0.88rem;
    line-height: 1.5;
  }

  /* Ways in */
  .sc-fd-ways {
    list-style: none;
    margin: 1.25rem 0;
    padding: 0;
    max-width: 70ch;
  }
  .sc-fd-ways > li {
    padding: 0.65rem 0;
    border-bottom: 1px solid #ece5d5;
  }
  .sc-fd-ways > li:last-child {
    border-bottom: 0;
  }
  .sc-fd-ways > li > a {
    font-family: var(--font-serif, Georgia, serif);
    font-size: 1.05rem;
    color: var(--deep-navy, #14243c);
  }
  .sc-fd-ways span {
    display: block;
    margin-top: 0.15rem;
    font-size: 0.88rem;
    line-height: 1.55;
    color: #4a4438;
  }
  .sc-fd-periods {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    margin-top: 0.35rem;
  }

  .sc-fd-aboutlinks {
    font-family: var(--font-sans);
    font-size: 0.85rem;
  }
  .sc-fd-corrections {
    margin: 2.5rem 0 0;
    padding-top: 1rem;
    border-top: 1px solid var(--rule-border, #d8d1c2);
    font-family: var(--font-sans);
    font-size: 0.82rem;
    color: #6b6355;
  }
  .sc-fd-portraits {
    list-style: none;
    margin: 1rem 0 0.5rem;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(96px, 1fr));
    gap: 0.75rem 0.6rem;
    max-width: 62rem;
  }
  .sc-fd-portraits li { text-align: center; }
  .sc-fd-portraits img {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    border: 1px solid var(--rule-border, #d8d1c2);
    background: #f4efe4;
  }
  .sc-fd-portraits span {
    display: block;
    margin-top: 0.25rem;
    font-family: var(--font-sans);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    color: #6b6353;
  }
  .sc-fd-caption {
    font-family: var(--font-sans);
    font-size: 0.86rem;
    line-height: 1.5;
    color: #4a4438;
    max-width: none;
    margin: 0.25rem 0 1rem;
  }

  .sc-introduction {margin:1.5rem 0 2.25rem}
  .sc-introduction p {font-size:1rem;line-height:1.7;margin:0 0 1rem}
  .sc-introduction figure {margin:1.5rem 0 0;width:100%;max-width:none}
  .sc-introduction img {display:block;width:100%;max-width:none;height:auto}
  .sc-introduction figcaption {font: .875rem/1.5 var(--font-sans);margin-top:.5rem}
  .sc-fd-edition {font: .9rem/1.5 var(--font-sans);margin-top:2rem;padding-top:1rem;border-top:1px solid #d8d1c2}
</style>
