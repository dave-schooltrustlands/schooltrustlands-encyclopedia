    display: block;
    margin-top: 0.15rem;
    font-size: 0.88rem;
    line-height: 1.55;
    color: #4a4438;
  }
  .sc-fd-periods {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    margin-top: 0.35rem;
  }

  .sc-fd-aboutlinks {
    font-family: var(--font-sans);
    font-size: 0.85rem;
  }
  .sc-fd-corrections {
    margin: 2.5rem 0 0;
    padding-top: 1rem;
    border-top: 1px solid var(--rule-border, #d8d1c2);
    font-family: var(--font-sans);
    font-size: 0.82rem;
    color: #6b6355;
  }
  .sc-fd-portraits {
    list-style: none;
    margin: 1rem 0 0.5rem;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(96px, 1fr));
    gap: 0.75rem 0.6rem;
    max-width: 62rem;
  }
  .sc-fd-portraits li { text-align: center; }
  .sc-fd-portraits img {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    border: 1px solid var(--rule-border, #d8d1c2);
    background: #f4efe4;
  }
  .sc-fd-portraits span {
    display: block;
    margin-top: 0.25rem;
    font-family: var(--font-sans);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    color: #6b6353;
  }
  .sc-fd-caption {
    font-family: var(--font-sans);
    font-size: 0.86rem;
    line-height: 1.5;
    color: #4a4438;
    max-width: none;
    margin: 0.25rem 0 1rem;
  }

  .sc-introduction {display:grid;grid-template-columns:minmax(0,1fr) 240px;gap:1.5rem;align-items:center;margin:1.5rem 0}
  .sc-introduction p {font-size:1rem;line-height:1.65;margin:.4rem 0}
  .sc-introduction figure {margin:0}.sc-introduction img {display:block;width:100%;height:auto}
  .sc-introduction figcaption {font: .875rem/1.5 var(--font-sans);margin-top:.5rem}
  .sc-fd-edition {font: .9rem/1.5 var(--font-sans);margin-top:2rem;padding-top:1rem;border-top:1px solid #d8d1c2}
  @media(max-width:620px){.sc-introduction{grid-template-columns:1fr}.sc-introduction figure{max-width:300px}}
</style>
