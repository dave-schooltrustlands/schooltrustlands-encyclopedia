---
export const prerender = true;
import RoomLayout from '../../../../layouts/RoomLayout.astro';
import ZybachNav from '../../../../components/zybach/ZybachNav.astro';
import trails from '../../../../data/zybach/guided_trails.json';
export function getStaticPaths(){return trails.map(trail=>({params:{slug:trail.slug},props:{trail}}));}
const {trail}=Astro.props;
const others=trails.filter(t=>t.slug!==trail.slug);
---
<RoomLayout room="collections" title={trail.title} subtitle={`A guided research trail · four stops · about ${trail.estimatedMinutes} minutes`} width="full" sourceId={`zybach-trail-${trail.slug}`} parents={[{label:'The Zybach Collection',href:'/collections/zybach/'},{label:'Guided trails',href:'/collections/zybach/trails/'}]}>
  <ZybachNav current="trails" />
  <div class="trail-opening"><figure><img src={trail.image.src} alt={trail.image.alt} width="600" height="380" /><figcaption>{trail.image.caption}<details><summary>Credit and original</summary><p>{trail.image.credit} <a href={trail.image.sourceUrl}>Creator’s original image</a></p></details></figcaption></figure><div><p class="trail-description">{trail.description}</p><p class="trail-how">Read the question, open the source, then move to the next stop. Source links open in a new tab so your place here stays put.</p><p class="trail-status" id="trail-status" role="status" aria-live="polite">Four connected sources to explore</p></div></div>
  <nav class="trail-steps" aria-label="Research trail stops">{trail.steps.map((s,i)=><a href={`#step-${i+1}`} data-step-link={i}><span>{i+1}</span>{s.title}</a>)}</nav>
  <div class="trail-panels">{trail.steps.map((s,i)=><section id={`step-${i+1}`} class="trail-panel" data-step-panel={i} aria-labelledby={`question-${i+1}`}>
    <p class="step-label">Stop {i+1} of {trail.steps.length}</p><h2 id={`question-${i+1}`}>{s.title}</h2><p class="instruction">{s.instruction}</p>
    {s.video && <div class="trail-video"><div class="video-holder" data-video-holder><button type="button" class="video-start" data-video-src={`https://www.youtube-nocookie.com/embed/${s.video.id}?start=${s.video.startSeconds}&end=${s.video.endSeconds}&autoplay=1&rel=0`} data-video-title={s.label}><span aria-hidden="true">▶</span> Play the selected stop<br/><small>10:46–13:54 · ORWWmedia · April 16, 2020</small></button></div><p>Playback is supplied by YouTube. <a href={s.video.watchUrl} target="_blank" rel="noopener">Watch the same moment on YouTube</a>.</p></div>}
    <a class="source-button" href={s.video?`${s.href}?t=${s.video.startSeconds}`:s.href} target="_blank" rel="noopener">{s.label} <span aria-hidden="true">↗</span></a>
    {s.secondaryHref&&<a class="secondary-source" href={s.secondaryHref} target="_blank" rel="noopener">{s.secondaryLabel} ↗</a>}
    <div class="step-controls" hidden><button type="button" data-prev disabled={i===0}>← Previous stop</button><button type="button" data-next disabled={i===trail.steps.length-1}>Next stop →</button></div>
  </section>)}</div>
  <section class="takeaway"><h2>Take the evidence with you</h2><p>Choose one thing you learned. Write down the author or speaker, the original work and the printed page or video time. Keep its web link with your note so someone else can check it.</p><a href="/collections/zybach/how-to-cite/">See a worked citation example →</a>{trail.related&&<p><a href={trail.related.href}>{trail.related.label} →</a></p>}</section>
  <details class="all-sources"><summary>All source links for this trail</summary><ol>{trail.steps.map(s=><li><a href={s.href}>{s.label}</a>{s.secondaryHref&&<> · <a href={s.secondaryHref}>{s.secondaryLabel}</a></>}</li>)}</ol></details>
  <section class="continue"><h2>Follow another question</h2><ul>{others.map(t=><li><a href={`/collections/zybach/trails/${t.slug}/`}>{t.title} →</a></li>)}</ul></section>
  <p class="editorial">Questions and connections: the Library, with Codex assistance. Original sources retain their own authorship and <a href="/collections/zybach/rights/">rights statements</a>. Some collection pages remain held.</p>
</RoomLayout>
<script>
const panels=[...document.querySelectorAll<HTMLElement>('[data-step-panel]')],links=[...document.querySelectorAll<HTMLAnchorElement>('[data-step-link]')];let current=0;
function selectStep(n:number,move=false){current=Math.min(Math.max(n,0),panels.length-1);panels.forEach((p,i)=>{p.hidden=i!==current;if(p.hidden){p.querySelectorAll('iframe').forEach(f=>f.remove());p.querySelectorAll<HTMLButtonElement>('[data-video-src]').forEach(b=>b.hidden=false)}});links.forEach((l,i)=>{if(i===current)l.setAttribute('aria-current','step');else l.removeAttribute('aria-current')});document.getElementById('trail-status')!.textContent=`Stop ${current+1} of ${panels.length}`;if(move){history.pushState({},'',`#step-${current+1}`);const h=panels[current].querySelector('h2')!;h.setAttribute('tabindex','-1');h.focus({preventScroll:true});panels[current].scrollIntoView({block:'nearest',behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'auto':'smooth'})}}
function fromHash(){const m=/^#step-(\d+)$/.exec(location.hash);selectStep(m?Number(m[1])-1:0)}
document.querySelectorAll<HTMLElement>('.step-controls').forEach(c=>c.hidden=false);links.forEach((a,i)=>a.addEventListener('click',e=>{e.preventDefault();selectStep(i,true)}));document.querySelectorAll('[data-prev]').forEach(b=>b.addEventListener('click',()=>selectStep(current-1,true)));document.querySelectorAll('[data-next]').forEach(b=>b.addEventListener('click',()=>selectStep(current+1,true)));window.addEventListener('popstate',fromHash);window.addEventListener('hashchange',fromHash);fromHash();
document.querySelectorAll<HTMLButtonElement>('[data-video-src]').forEach(b=>b.addEventListener('click',()=>{const f=document.createElement('iframe');f.src=b.dataset.videoSrc!;f.title=b.dataset.videoTitle!;f.allow='autoplay; encrypted-media; picture-in-picture';f.allowFullscreen=true;b.hidden=true;b.closest('[data-video-holder]')!.append(f)}));
</script>
<style>
.trail-opening{display:grid;grid-template-columns:1.05fr 1fr;gap:2rem;margin:1.7rem 0;align-items:center}.trail-opening figure{margin:0}.trail-opening img{display:block;width:100%;aspect-ratio:1.65;object-fit:cover}.trail-opening figcaption{font-family:var(--font-sans);font-size:.82rem;line-height:1.5;color:#5f625b;margin-top:.6rem}.trail-opening details{margin-top:.35rem}.trail-description{font-size:1.23rem;line-height:1.6}.trail-how{font-family:var(--font-sans);font-size:1rem;line-height:1.6;color:#57616b}.trail-status{font-family:var(--font-sans);font-weight:700;color:#3d626d;font-size:.9rem}.trail-steps{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:.6rem;font-family:var(--font-sans);margin:1.7rem 0 1rem}.trail-steps a{border:1px solid #bcc7c9;display:flex;align-items:center;gap:.6rem;padding:.8rem;font-size:.87rem;line-height:1.4;text-decoration:none;color:#193346;background:white}.trail-steps a span{font-size:1.3rem;font-weight:700}.trail-steps a[aria-current=step]{background:#193346;color:white;border-color:#193346}.trail-panel{background:white;border:1px solid #c8c8bc;padding:2rem;margin-bottom:1rem;scroll-margin-top:15rem}.trail-panel[hidden]{display:none}.step-label{font-family:var(--font-sans);font-size:.82rem;color:#736344;text-transform:uppercase;letter-spacing:.06em}.trail-panel h2{font-family:var(--font-serif);font-size:1.8rem;line-height:1.25;margin:.5rem 0 1rem}.instruction{font-size:1.15rem;line-height:1.7;max-width:70ch}.source-button{display:inline-block;background:#193346;color:#fff;padding:.85rem 1.15rem;margin:.6rem 0;text-decoration:none;font-family:var(--font-sans);font-size:1rem;line-height:1.45}.secondary-source{display:block;margin:.8rem 0;font-family:var(--font-sans)}.step-controls{display:flex;justify-content:space-between;gap:1rem;border-top:1px solid #e0ded4;margin:1.4rem 0 0;padding-top:1rem}.step-controls[hidden]{display:none}.step-controls button{font-family:var(--font-sans);background:#f0f2ed;border:1px solid #bdc8c9;color:#193346;padding:.6rem 1rem;cursor:pointer;font-size:1rem}.step-controls button:disabled{opacity:.35;cursor:default}.takeaway{border-left:4px solid #b29a58;background:#f0efe7;padding:1.5rem;margin:2rem 0;font-family:var(--font-sans);line-height:1.6}.takeaway h2,.continue h2{font-size:1.3rem;margin:0 0 .8rem}.all-sources{font-family:var(--font-sans);margin:1.5rem 0}.all-sources li{margin:.7rem 0}.all-sources summary{cursor:pointer;padding:.4rem 0}.continue{font-family:var(--font-sans);margin:2rem 0}.continue ul{list-style:none;padding:0}.continue li{margin:.75rem 0}.editorial{font-family:var(--font-sans);font-size:.83rem;line-height:1.6;color:#58616a}.trail-video{margin:1.5rem 0;font-family:var(--font-sans);font-size:.85rem}.video-holder{aspect-ratio:16/9;background:#142c3e;display:grid;place-items:center}.video-holder :global(iframe){width:100%;height:100%;border:0}.video-start{width:100%;height:100%;background:#193346;color:white;font-family:var(--font-sans);font-size:1.2rem;border:0;cursor:pointer;padding:1.5rem;line-height:1.6}.video-start>span{display:block;font-size:2.5rem;color:#e4c47a}.video-start small{font-size:.9rem;color:#dae3e5}
@media(max-width:700px){.trail-opening{grid-template-columns:1fr;gap:1rem}.trail-steps{grid-template-columns:repeat(2,minmax(0,1fr))}.trail-panel{padding:1.2rem}.trail-panel h2{font-size:1.5rem}.instruction,.trail-description{font-size:1.08rem}.step-controls button{font-size:.9rem;padding:.6rem}.trail-panel{scroll-margin-top:6rem}}
</style>
