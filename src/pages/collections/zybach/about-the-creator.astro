/* Verbatim from the thesis, with the printed page each passage sits on.
   Read from thesis.json → methodology[]; not retyped from the PDF. */
const passages: ReadonlyArray<{ page: number; text: string; gloss: string }> = [
  {
    page: 28,
    gloss: 'On what kind of history this is',
    text:
      'The Soap Creek Valley Oral History Series, however, is probably best categorized as a “geographical oral history,” qualifying as a possible fourth type of oral history.',
  },
  {
    page: 35,
    gloss: 'On who he asked',
    text:
      'Two criteria were applied to all selections: participants must have had a first-hand knowledge of events in Soap Creek Valley and they must have lived or worked in the area for a significant period of time.',
  },
  {
    page: 44,
    gloss: 'On the tape being the record, and the narrator keeping the last word',
    text:
