---
import BaseLayout from '../../layouts/BaseLayout.astro';

const groups = [
  {
    title: 'Method',
    items: [
      {
        label: 'How this library works',
        href: '/about/how-this-works/',
        note: 'The full method statement: sources, citations, verification, versions, and submissions.',
      },
      {
        label: 'Editorial standards',
        href: '/pro/editorial-standards/',
        note: 'The rules the Library&rsquo;s editors work under.',
      },
      {
        label: 'Metadata schema',
        href: '/pro/metadata-schema/',
        note: 'How catalog records are structured.',
      },
      {
        label: 'How to cite',
        href: '/about/cite/',
        note: 'Citing Library pages in scholarship, briefs, and news.',
      },
    ],
  },
  {
    title: 'Record',
    items: [
      {
        label: 'Building this library',
        href: '/about/becoming/',
        note: 'The record of how the Library was assembled.',
      },
      {
        label: 'Organizational record',
        href: '/organizing/',
        note: 'The Library&rsquo;s organizational documents.',
      },
      {
        label: 'Governance',
        href: '/governance/',
        note: 'How the Library is governed.',
      },
      {
        label: 'Bylaws',
        href: '/bylaws/',
        note: 'The bylaws in full.',
      },
      {
        label: 'Constitution &amp; Readers&rsquo; Bill of Rights',
        href: '/rights/',
        note: 'The Library&rsquo;s constitution and what it promises readers.',
      },
      {
        label: 'Independence',
        href: '/independence/',
        note: 'The founder&rsquo;s dual role, on the record.',
      },
    ],
  },
  {
    title: 'Practice',
    items: [
      {
        label: 'Corrections system',
        href: '/about/corrections/',
        note: 'How corrections are proposed, decided, and logged.',
      },
      {
        label: 'Contributing in depth',
        href: '/about/contributing/',
        note: 'The full contributor pathway, beyond the short version on Contribute.',
      },
      {
        label: 'Roles',
        href: '/pro/roles/',
        note: 'Named roles and what each one is responsible for.',
      },
      {
        label: 'The Watchful Crew',
        href: '/the-watchful-crew/',
        note: 'The public ledger of who holds which office.',
      },
      {
        label: 'The Workshop',
        href: '/workshop/',
        note: 'What is on the bench right now, with its status shown.',
      },
    ],
  },
  {
    title: 'History',
    items: [
      {
        label: 'Site changelog',
        href: '/librarians/changelog/',
        note: 'Every site update, in full.',
      },
      {
        label: 'Updates',
        href: '/updates/',
        note: 'Milestones in the Library&rsquo;s construction.',
      },
    ],
  },
];
---

<BaseLayout
  title="The Librarians' Room - America's School Trust Library"
  description="The Librarians' Room of America's School Trust Library: method, record, practice, and history — how the Library is made, governed, and corrected, gathered in one place."
  sourceId="librarians-corps"
>
  <article class="prose prose-slate max-w-none prose-a:text-blue-700 prose-a:underline">
    <p class="text-xs uppercase tracking-wide text-slate-500">The Librarians' Room</p>
    <h1>The Librarians' Room</h1>
    <p class="kicker">
      This room is for the people who work on the Library — editors,
      contributors, correspondents — and for readers who want to see how the
      collection is made, governed, and corrected. The reader-facing pages stay
      about their subject, school trust lands; everything about the Library
      itself gathers here.
    </p>
  </article>

  {groups.map((group) => (
    <section class="room-group" aria-label={group.title}>
      <h2>{group.title}</h2>
      <ul>
        {group.items.map((item) => (
          <li>
            <a href={item.href} set:html={item.label}></a>
            <span class="note" set:html={' — ' + item.note}></span>
          </li>
        ))}
      </ul>
    </section>
  ))}

  <article class="prose prose-slate mt-10 max-w-none prose-a:text-blue-700 prose-a:underline">
    <h2>Working here</h2>
    <p>
      Recognition follows work already done. The Library does not confer public
      authority because someone volunteers in the abstract; it recognizes a
      person after a useful artifact has entered the public record. The first
      useful act is usually a correction, a missing primary source, or a narrow
      verification note on a hornbook citation.
    </p>
    <p class="cta-row">
      <a href="/library-card/" class="cta-primary">Get a Library Card</a>
      <a href="/contribute/" class="cta-secondary">How to contribute</a>
    </p>
  </article>

  <style>
    .kicker {
      color: #475569;
      font-style: italic;
    }
    .room-group {
      margin-top: 2rem;
    }
    .room-group h2 {
      margin: 0 0 0.6rem;
      font-size: 1.15rem;
      font-weight: 700;
      color: #0f172a;
    }
    .room-group ul {
      margin: 0;
      padding: 0;
      list-style: none;
    }
    .room-group li {
      padding: 0.45rem 0;
      border-bottom: 1px solid #e2e8f0;
      line-height: 1.55;
    }
    .room-group a {
      color: #1d4ed8;
      font-weight: 600;
      text-decoration: underline;
    }
    .room-group .note {
      color: #334155;
      font-size: 0.95rem;
    }
    .cta-row {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem;
    }
    .cta-primary,
    .cta-secondary {
      display: inline-block;
      padding: 0.55rem 1rem;
      border-radius: 4px;
      font-family: var(--font-sans, system-ui, sans-serif);
      font-size: 0.9rem;
      font-weight: 700;
      text-decoration: none !important;
    }
    .cta-primary {
      background: #1e3a5f;
      color: #fff !important;
    }
    .cta-secondary {
      border: 1px solid #1e3a5f;
      color: #1e3a5f !important;
      background: #fff;
    }
  </style>
</BaseLayout>
