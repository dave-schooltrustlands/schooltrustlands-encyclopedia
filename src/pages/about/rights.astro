import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Rights, Use, and Takedown · America's School Trust Library"
  description="This page has moved. Rights, Use, and Takedown now lives at /permissions/."
  sourceId="about-rights"
>
  <article class="prose prose-slate max-w-none prose-a:text-blue-700 prose-a:underline">
    <p class="kicker">About</p>
    <h1>Rights, Use, and Takedown has moved</h1>

    <p>
      The Library's permissions notice — what readers may do with Library
      material, how to ask for a takedown, and the difference between correction
      and removal — now lives at
      <a href="/permissions/">Rights, Use, and Takedown</a>.
    </p>

    <p>
      This route remains in place so older citations do not break. The path
      <code>/rights/</code> now carries the Library's
      <a href="/rights">Constitution and Readers' Bill of Rights</a>, one of the
      adopted governing instruments published on the
      <a href="/governance">Governance</a> page.
    </p>
  </article>

  <style>
    .kicker {
      font-family: var(--font-sans);
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: #A88A4E;
      margin: 0 0 0.4rem;
    }
  </style>
